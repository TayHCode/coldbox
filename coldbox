    print(f'coldbox {VERSION} (build {build_id()})')
    failures = []

    def check(ok, text, fix):
        print(f"{'PASS' if ok else 'FAIL'}  {text}")
        if not ok:
            print(f'      fix: {fix}')
            failures.append(text)

    check(Path('/dev/kvm').exists(), 'hardware virtualization (/dev/kvm)', kvm_fix())
    try:
        if app_token():
            check(True, 'GitHub auth: GitHub App installation token', '')
        elif subprocess.run(['gh', 'auth', 'status'], capture_output=True).returncode == 0:
            print('WARN  GitHub auth: personal gh login, which can do anything its account can')
            print('      fix: coldbox setup-app (a GitHub App with only runner administration)')
        else:
            check(False, 'GitHub auth: no GitHub App and no gh login', 'coldbox setup-app')
    except OSError:
        check(False, 'GitHub auth: no GitHub App and gh is not installed', 'coldbox setup-app')
    except RuntimeError as error:
