def size_bytes(text):
    match = re.fullmatch(r'\s*(\d+(?:\.\d+)?)\s*([KMGT]i?B|B)?\s*', text)
    if not match:
        raise ValueError(f'cannot read size {text!r}')
    return int(float(match[1]) * UNITS[match[2] or ''])


def host_memory(field='MemTotal'):
    for line in Path('/proc/meminfo').read_text().splitlines():
        if line.startswith(f'{field}:'):
            arc = min(reclaimable_arc(), memory_floor(host_memory())) if field == 'MemAvailable' else 0
            return int(line.split()[1]) * 1024 + arc
    raise RuntimeError(f'{field} missing from /proc/meminfo')


def reclaimable_arc():
    """Clean ZFS ARC buffers above c_min, which ZFS evicts under memory pressure but MemAvailable does not count
    (OpenZFS arc_evictable_memory). A page-cache ARC minimum (zfs_arc_pc_percent) raises c_min, so none counts then."""
    try:
        if Path('/sys/module/zfs/parameters/zfs_arc_pc_percent').read_text().strip() != '0':
            return 0
        stats = dict(line.split()[::2] for line in Path('/proc/spl/kstat/zfs/arcstats').read_text().splitlines()[2:])
        clean = sum(int(stats[f'{state}_evictable_{kind}']) for state in ('mru', 'mfu') for kind in ('data', 'metadata'))
        return max(0, min(clean, int(stats['size']) - int(stats['c_min'])))
    except (OSError, KeyError, ValueError):
        return 0


def memory_floor(total):
    return max(HOST_RESERVE, total // 8)


def host_share(host):
    return memory_floor(host) + HOST_IDLE


def fits(slots, vm_memory, host):
    return slots * vm_memory <= host - host_share(host)


def large_memory(memory, host):
    return max(memory, min(2 * memory, host - host_share(host)))


def slot_limit(memory, host, reserve):
    return min(vm_bound(reserve) - 1, (host - host_share(host) - large_memory(memory, host)) // memory)


def vm_bound(reserve):
    return (os.cpu_count() - reserve) // CORES_PER_JOB


def runner_release(release):
    version = release['tag_name'].removeprefix('v')
    name = f'actions-runner-linux-x64-{version}.tar.gz'
    asset = next((a for a in release.get('assets', []) if a['name'] == name), None)
    if not asset:
        raise RuntimeError(f'actions/runner {version} has no {name}')
    digest = (asset.get('digest') or '').removeprefix('sha256:')
    if not digest:
        match = re.search(r'BEGIN SHA linux-x64 -->\s*([0-9a-f]{64})', release.get('body') or '')
        digest = match[1] if match else ''
    if not re.fullmatch(r'[0-9a-f]{64}', digest):
        raise RuntimeError(f'actions/runner {version}: no sha256 for {name}')
    return version, asset['browser_download_url'], digest


def detect(root):
    root = Path(root)

    def has(*names):
        return any((root / name).exists() for name in names)

    def files(pattern):
        return [p for p in root.rglob(pattern)
                if not any(part.startswith('.') or part in SKIP_DIRS for part in p.relative_to(root).parts)]

    found = {}

    def add(check, command):
        found.setdefault(check, []).append(command)

    if has('pyproject.toml', 'setup.py', 'setup.cfg', 'requirements.txt', 'ruff.toml', '.ruff.toml', 'mypy.ini',
           '.mypy.ini') or files('*.py'):
        if has('requirements.txt'):
            add('setup', 'pip3 install -r requirements.txt')
        add('lint', "python3 -m compileall -q -x '/[.]|node_modules' .")
        try:
            pyproject = tomllib.loads((root / 'pyproject.toml').read_text())
        except (OSError, tomllib.TOMLDecodeError):
            pyproject = {}
        tool = pyproject.get('tool') if isinstance(pyproject.get('tool'), dict) else {}
        if isinstance(tool.get('ruff'), dict) or has('ruff.toml', '.ruff.toml'):
            add('lint', PY_VENV + 'pip install -q ruff && ruff check .')
        mypy = tool.get('mypy') if isinstance(tool.get('mypy'), dict) else None
        ini_file = next((root / name for name in ('mypy.ini', '.mypy.ini') if has(name)), None)
        if ini_file:
            ini = configparser.ConfigParser(interpolation=None)
            try:
                ini.read(ini_file)
            except (configparser.Error, UnicodeDecodeError):
                pass
            listed = ini.get('mypy', 'files', fallback=None)
        else:
            listed = mypy and mypy.get('files')
        if mypy is not None or ini_file:
            install = 'mypy' + (' .' if 'project' in pyproject else '') + (' -r requirements.txt' if has('requirements.txt') else '')
            add('lint', PY_VENV + f"pip install -q {install} && mypy{'' if listed else ' .'}")
        if files('test_*.py') or files('*_test.py'):
            add('test', 'python3 -m pytest -q')
    if has('package.json'):
        package = json.loads((root / 'package.json').read_text())
        scripts = package.get('scripts', {})
        deps = package.get('dependencies', {}) | package.get('devDependencies', {})

        def configured(tool, *patterns):
            return tool in deps or tool in package or any(next(root.glob(p), None) for p in patterns)

        pinned = package.get('packageManager')
        pinned = pinned.split('+')[0] if isinstance(pinned, str) else ''
        lock = 'pnpm' if has('pnpm-lock.yaml') else 'yarn' if has('yarn.lock') else None
        version = pinned.removeprefix(f'{lock}@') if lock and re.fullmatch(rf'{lock}@[0-9][0-9A-Za-z.-]*', pinned) else ''
        berry = lock == 'yarn' and version and version.split('.')[0] != '1' and not has('package-lock.json')
        run = f'npx --yes -p @yarnpkg/cli-dist@{version} yarn' if berry else 'npx --yes'
        if has('package-lock.json'):
            add('setup', 'npm ci')
        elif lock:
            if berry:
                add('setup', f'{run} install --immutable')
            else:
                add('setup', f"npx --yes {lock}{'@' + version if version else ''} install --frozen-lockfile")
        else:
            add('setup', 'npm install')
        if 'lint' in scripts:
            add('lint', 'npm run lint')
        elif configured('eslint', 'eslint.config.*', '.eslintrc*') or 'eslintConfig' in package:
            add('lint', f'{run} eslint .')
        if has('tsconfig.json'):
            add('lint', f'{run} tsc --noEmit' if berry else 'npx --yes -p typescript tsc --noEmit')
        if 'test' in scripts and 'no test specified' not in scripts['test']:
            add('test', 'npm test')
        elif configured('vitest', 'vitest.config.*'):
            add('test', f'{run} vitest run')
        elif configured('jest', 'jest.config.*'):
            add('test', f'{run} jest')
    if has('go.mod'):
        add('lint', 'test -z "$(gofmt -l .)" && go vet ./...')
        if files('*_test.go'):
            add('test', GO_TEST)
    if has('Cargo.toml'):
        add('lint', 'cargo fmt --check && cargo clippy --all-targets -- -D warnings')
        if any(RUST_TEST.search(p.read_text(errors='replace')) for p in files('*.rs')):
            add('test', CARGO_TEST)
    if files('*.sh'):
        add('lint', "find . -name '*.sh' -not -path '*/.*' -not -path '*/node_modules/*' -print0 | xargs -0 shellcheck")
    return found


def load_config(path, label='coldbox.toml'):
    if not path.exists():
        return {}, {}, None
    try:
        data = tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError as error:
        raise ConfigError(f'{label}: {error}')
    unknown = set(data) - {'checks', 'commands', 'vm'}
    if unknown:
        raise ConfigError(f'{label}: unknown section {sorted(unknown)[0]!r}; use [checks], [commands] and [vm]')
    vm = data.get('vm', {})
    if not isinstance(vm, dict) or set(vm) - {'size'} or 'vm' in data and vm.get('size') not in SIZES:
        raise ConfigError(f'{label}: [vm] holds only size = {" | ".join(map(repr, SIZES))}')
    switches, commands = data.get('checks', {}), data.get('commands', {})
    for section, table, kind in (('checks', switches, bool), ('commands', commands, str)):
        if not isinstance(table, dict):
            raise ConfigError(f'{label}: [{section}] must be a table')
        for name, value in table.items():
            if not NAME.fullmatch(name):
                raise ConfigError(f'{label}: bad check name {name!r} in [{section}]')
            if type(value) is not kind or (kind is str and not value.strip()):
                raise ConfigError(f'{label}: [{section}] {name} must be {"true or false" if kind is bool else "a command string"}')
    return switches, commands, vm.get('size')


def host_switches():
    switches, commands, size = load_config(HOST_CHECKS, str(HOST_CHECKS))
    if commands or size:
        raise ConfigError(f'{HOST_CHECKS}: only [checks] belongs here; put [commands] and [vm] in the repo coldbox.toml')
    return switches


def plan(root):
    host = host_switches()
    switches, overrides, _ = load_config(Path(root) / 'coldbox.toml')
    found = detect(root)
    found.update({name: [command] for name, command in overrides.items()})
    missing = [name for name, on in switches.items() if on and name not in found]
    if missing:
        raise ConfigError(f'coldbox.toml: check {missing[0]!r} is on but nothing was detected; add it under [commands]')
    if 'verify' not in found and switches.get('verify', host.get('verify', True)) and (Path(root) / '.fleet/verify.sh').exists():
        raise ConfigError('coldbox.toml: Coldbox no longer runs .fleet/verify.sh by itself; add verify = "coldverify --ci" '
                          'under [commands], or verify = false under [checks]')
    names = [n for n in CHECK_ORDER if n in found] + [n for n in found if n not in CHECK_ORDER]
    return [(name, found[name]) for name in names if switches.get(name, host.get(name, True))]


def run_checks(root, out=None):
    steps = plan(root)
    results, setup_failed = [], False
    junit_dir = out and Path(out).parent / 'junit' / str(os.getpid())
    for name, commands in steps:
        for command in commands:
            if setup_failed:
                results.append(dict(check=name, command=command, status='not_run', exit=None, seconds=0))
                continue
            print(f'== coldbox {name}: {command}', flush=True)
            started = time.monotonic()
            env = dict(os.environ)
            if out and not sets_junitxml(root, command):
                junit_dir.mkdir(parents=True, exist_ok=True)
                env['COLDBOX_JUNIT'] = str(junit_dir / f'{len(results)}-count.xml')
                junit = f"--junitxml={junit_dir / f'{len(results)}.xml'}"
                env['PYTEST_ADDOPTS'] = ' '.join(filter(None, [os.environ.get('PYTEST_ADDOPTS'), junit]))
            code = subprocess.run(['bash', '-eo', 'pipefail', '-c', command], cwd=root, env=env).returncode
            results.append(dict(check=name, command=command, status='pass' if code == 0 else 'fail',
                                exit=code, seconds=round(time.monotonic() - started, 3)))
            setup_failed = name == 'setup' and code != 0
    verdict = 'pass' if results and all(r['status'] == 'pass' for r in results) else 'fail'
    summary = dict(verdict=verdict, checks=results)
    if not results:
        summary['error'] = 'no checks to run'
    if out:
        write_json(out, summary)
    for r in results:
        print(f"{r['status'].upper():8} {r['check']:8} {r['seconds']:8.1f}s  {r['command']}")
    print(f'coldbox checks: {verdict.upper()}' + (' (nothing to run)' if not results else ''))
    if os.environ.get('GITHUB_ACTIONS') == 'true':
        annotate(results, junit_dir)
    return 0 if verdict == 'pass' else 1


def annotate(results, junit_dir):
    def error(title, message):
        message = message.replace('%', '%25').replace('\r', '%0D').replace('\n', '%0A')
        print(f'::error title={title}::{message}', flush=True)

    tests = junit_summary([junit_dir]) if junit_dir else dict(failed=0, error=0, results=[])
    count = tests['failed'] + tests['error']
    names = ['.'.join(filter(None, (t['classname'], t['name'])))
             for t in tests['results'] if t['status'] in ('failed', 'error')][:10]
    if count:
        error(f'coldbox {count} test(s) failed', ', '.join(names + ['...'] * (count > len(names))))
    for r in results:
        if r['status'] == 'fail':
            error(f"coldbox {r['check']} failed", f"{r['command']} exited {r['exit']}")
    if not results:
        error('coldbox found nothing to run', 'switch a check on or add one under [commands] in coldbox.toml')


def sets_junitxml(root, command):
    configs = [Path(root) / name for name in PYTEST_CONFIGS]
    texts = [command, os.environ.get('PYTEST_ADDOPTS', '')]
    texts += [path.read_text(errors='replace') for path in configs if path.is_file()]
    return any('junitxml' in text for text in texts)


def tracked(path):
    return subprocess.run(['git', '-C', str(path.parent), 'ls-files', '--error-unmatch', '--', path.name],
                          capture_output=True).returncode == 0


def junit_files(dirs, since=0, archived=frozenset()):
    for top in dirs:
        for root, subdirs, names in os.walk(top):
            subdirs[:] = sorted(d for d in subdirs if not d.startswith('.') and d not in ('node_modules', 'vendor'))
            for name in sorted(names):
                path = Path(root) / name
                try:
                    if not name.endswith('.xml') or path.stat().st_mtime < since:
                        continue
                    with path.open('rb') as report:
                        if b'<testsuite' in report.read(4096) and str(path) not in archived and not tracked(path):
                            yield path
                except OSError:
                    pass


def junit_seconds(text):
    try:
        return round(float(text), 3)
    except (TypeError, ValueError):
        return None


def junit_summary(dirs, newer=None, archived=None):
    files, results = [], []
    skip = frozenset(Path(archived).read_text().splitlines()) if archived else frozenset()
    for path in junit_files(dirs, os.stat(newer).st_mtime if newer else 0, skip):
        try:
            report = ET.parse(path).getroot()
        except (ET.ParseError, OSError):
            continue
        files.append(str(path))
        for suite in report.iter('testsuite'):
            for case in suite.findall('testcase'):
                status = next((s for tag, s in JUNIT_STATUS if case.find(tag) is not None), 'passed')
                results.append(dict(suite=suite.get('name', ''), classname=case.get('classname', ''),
                                    name=case.get('name', ''), status=status, seconds=junit_seconds(case.get('time'))))
    counts = {status: sum(r['status'] == status for r in results) for status in ('passed', 'failed', 'error', 'skipped')}
    return dict(files=files, total=len(results), **counts, truncated=len(results) > MAX_TEST_RESULTS,
                results=results[:MAX_TEST_RESULTS])


def cold_verify_counts(dirs, newer=None, archived=None):
    since = os.stat(newer).st_mtime if newer else 0
    skip = frozenset(Path(archived).read_text().splitlines()) if archived else frozenset()
    counts = []
    for top in dirs:
        for root, subdirs, names in os.walk(top):
            subdirs[:] = sorted(d for d in subdirs if d == '.cold' or not d.startswith('.') and d not in ('node_modules', 'vendor'))
            path = Path(root) / 'verify-result.json'
            try:
                if Path(root).name != '.cold' or 'verify-result.json' not in names or path.stat().st_mtime < since \
                        or str(path) in skip or tracked(path):
                    continue
            except OSError:
                continue
            try:
                count = json.loads(path.read_text()).get('tests_ran')
            except (OSError, ValueError, AttributeError):
                count = None
            counts.append(count if type(count) is int and count >= 0 else None)
    return counts


def tests_ran(junit, cold_verify):
    if junit['files']:
        return junit['total'] - junit['skipped'], 'junit'
    if None in cold_verify:
        return None, 'cold-verify'
    if cold_verify:
        return sum(cold_verify), 'cold-verify'
    return 0, None


def job_started(env=None):
    env = os.environ if env is None else env
    if env.get('COLDBOX_CI_PRIMARY'):
        admission_check(argparse.Namespace(expected_primary=env['COLDBOX_CI_PRIMARY']), env=env)
    event = {}
    if env.get('GITHUB_EVENT_PATH'):
        event = json.loads(Path(env['GITHUB_EVENT_PATH']).read_text())
    name = env.get('GITHUB_EVENT_NAME') or ''
    fork = None if name not in SAME_REPO_EVENTS else False
    pr = event.get('pull_request')
    if pr:
        repos = (pr.get('head') or {}).get('repo'), (pr.get('base') or {}).get('repo')
    elif name == 'workflow_run':
        repos = (event.get('workflow_run') or {}).get('head_repository'), event.get('repository')
    if pr or name == 'workflow_run':
        head, base = ((repo or {}).get('full_name') for repo in repos)
        fork = head is None or head != base
    writers, refused = env.get('COLDBOX_PUBLIC_WRITERS'), None
    if writers is not None:
        actor = env.get('GITHUB_TRIGGERING_ACTOR') or env.get('GITHUB_ACTOR')
        refused = outsider(name, fork, actor, writers.split(','))
    elif fork is not False and env.get('COLDBOX_ALLOW_FORKS') != '1':
        refused = 'fork pull request' if fork else f'{name or "unknown"} event: cannot tell whether the code is from a fork'
    job = dict(repo=env.get('GITHUB_REPOSITORY'), sha=env.get('GITHUB_SHA'), ref=env.get('GITHUB_REF'),
               event=name, workflow=env.get('GITHUB_WORKFLOW'), job=env.get('GITHUB_JOB'),
               run_id=env.get('GITHUB_RUN_ID'), run_attempt=env.get('GITHUB_RUN_ATTEMPT'),
               actor=env.get('GITHUB_ACTOR'), fork_pr=fork, refused=refused, started_at=now_iso())
    if env.get('COLDBOX_JOB_DIR'):
        write_json(Path(env['COLDBOX_JOB_DIR']) / 'job.json', job)
    if refused:
        hint = '' if writers is not None else '; register with --allow-forks to run it'
        print(f'coldbox: refusing this job ({refused}){hint}', file=sys.stderr)
        return 1
    return 0


def record_queue_wait(metadata, runner):
    try:
        path = (f"repos/{metadata['repo']}/actions/runs/{metadata['run_id']}/"
                f"attempts/{metadata['run_attempt']}/jobs?")
        jobs, page = [], 1
        while True:
            batch = gh(f'{path}per_page=100&page={page}')['jobs']
            jobs.extend(batch)
            if len(batch) < 100:
                break
            page += 1
        matched = next(job for job in jobs if job.get('runner_name') == runner)
        queued, started = matched['created_at'], matched['started_at']
        seconds = (datetime.fromisoformat(started) -
                   datetime.fromisoformat(queued)).total_seconds()
        if seconds < 0:
            raise ValueError('job started before it was queued')
        metadata.update(job_id=matched['id'], queued_at=queued, runner_started_at=started,
                        queue_wait_seconds=round(seconds, 3))
        if matched.get('completed_at'):
            metadata['completed_at'] = matched['completed_at']
        if steps := job_steps(matched.get('steps')):
            metadata['steps'] = steps
        print(f'coldbox: {runner} queue waited {seconds:g} s', file=sys.stderr, flush=True)
    except (OSError, RuntimeError, ValueError, KeyError, TypeError, StopIteration) as error:
        print(f'coldbox: queue wait unavailable for {runner}: {error}', file=sys.stderr, flush=True)


def job_steps(steps):
    found = []
    for step in steps or []:
        try:
            seconds = (datetime.fromisoformat(step['completed_at']) -
                       datetime.fromisoformat(step['started_at'])).total_seconds()
        except (KeyError, TypeError, ValueError):
            seconds = None
        found.append(dict(name=step.get('name'), conclusion=step.get('conclusion'),
                          seconds=round(seconds, 3) if seconds is not None and seconds >= 0 else None))
    return found


def outsider(event, fork, actor, writers):
    """Why a job on an opted-in public repo must not run, or None. Users with write access run anything; anyone else
    runs only a pull request from a fork, which GitHub holds until someone with write access approves it."""
    if actor and actor.casefold() in {writer.casefold() for writer in writers}:
        return None
    if event == 'pull_request' and fork:
        return None
    return f'{event or "unknown"} event triggered by {actor or "an unknown user"}, who has no write access'


def acl_document(addresses):
    blocked = ['0.0.0.0/8', '10.0.0.0/8', '100.64.0.0/10', '127.0.0.0/8', '169.254.0.0/16', '172.16.0.0/12',
               '192.0.0.0/24', '192.0.2.0/24', '192.168.0.0/16', '198.18.0.0/15', '198.51.100.0/24',
               '203.0.113.0/24', '224.0.0.0/4', '240.0.0.0/4']
    public = [ipaddress.ip_network('0.0.0.0/0')]
    for cidr in blocked:
        net = ipaddress.ip_network(cidr)
        public = [part for old in public for part in (old.address_exclude(net) if net.subnet_of(old) else [old])]
    egress = [dict(action='allow', state='enabled', destination=str(net)) for net in public]
    for protocol, ports in (('udp', '53,67'), ('tcp', '53')):
        egress.append(dict(action='allow', state='enabled', destination=GATEWAY, protocol=protocol,
                           destination_port=ports))
    egress.append(dict(action='allow', state='enabled', destination='255.255.255.255', protocol='udp',
                       destination_port='67'))
    for interface in addresses:
        for addr in interface.get('addr_info', []):
            if addr['family'] == 'inet' and ipaddress.ip_address(addr['local']).is_global:
                egress.insert(0, dict(action='reject', state='enabled', destination=addr['local']))
    ingress = [dict(action='allow', state='enabled', source=GATEWAY, protocol='udp', source_port='67',
                    destination_port='68')]
    return dict(description='Coldbox: public internet only; no LAN, tailnet or host',
                config={'user.coldbox.managed': 'true'},
                ingress=ingress, egress=egress)


def host_addresses():
    return json.loads(subprocess.run(['ip', '-j', 'address', 'show'], check=True, capture_output=True,
                                     text=True).stdout)


def sync_acl():
    subprocess.run(['incus', '--force-local', 'network', 'acl', 'edit', NETWORK_ACL],
                   input=json.dumps(acl_document(host_addresses())), check=True, capture_output=True, text=True)


def query(path):
    return json.loads(subprocess.run(['incus', '--force-local', 'query', path], check=True, capture_output=True,
                                     text=True).stdout)


def ic(*args, **kwargs):
    return subprocess.run(['incus', '--force-local', '--project', PROJECT, *args], check=True, text=True,
                          stdin=subprocess.DEVNULL, capture_output=True, **kwargs).stdout


def ic_exec(name, *command, user=RUNNER, cwd=None, env=(), timeout=None):
    prefix = ['timeout', '--signal=KILL', str(max(1, int(timeout)))] if timeout else []
    args = ['incus', '--force-local', '--project', PROJECT, 'exec', name, '--mode', 'non-interactive']
    if user:
        args += ['--env', f'HOME=/home/{user}']
        command = ('runuser', '-u', user, '--', *command)
    if cwd:
        args += ['--cwd', cwd]
    for item in env:
        args += ['--env', item]
    return prefix + args + ['--', *command]


def tee(command, log, data=None):
    proc = subprocess.Popen(command, stdin=subprocess.PIPE if data is not None else subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if data is not None:
        proc.stdin.write(data)
        proc.stdin.close()
    for line in proc.stdout:
        log.write(line)
        log.flush()
        sys.stdout.buffer.write(line)
        sys.stdout.flush()
    return proc.wait()


def isolated(name, offline):
    vm = query(f'/1.0/instances/{name}?project={PROJECT}')
    devices, config = vm.get('expanded_devices', {}), vm.get('expanded_config', {})
    root, nic = devices.get('root', {}), devices.get('eth0', {})
    problems = []
    if vm.get('type') != 'virtual-machine':
        problems.append('not a VM')
    if set(devices) != {'root', 'eth0'}:
        problems.append(f'unexpected devices {sorted(devices)}')
    if root.get('type') != 'disk' or root.get('path') != '/' or root.get('source'):
        problems.append('root disk is not a plain pool volume')
    if offline and nic.get('type') != 'none':
        problems.append('offline VM still has a NIC')
    if not offline and (nic.get('type') != 'nic' or nic.get('network') != BRIDGE
                        or nic.get('security.port_isolation') != 'true'):
        problems.append(f'NIC is not on the isolated {BRIDGE} bridge')
    if any(key.startswith('raw.') for key in config):
        problems.append('raw.* config present')
    if problems:
        raise RuntimeError('Refusing unsafe VM: ' + '; '.join(problems))


BOOT_SECONDS = 300
STOPPED_SECONDS = 30


def wait_ready(name, expires, network, restarts=3):
    boot_deadline = time.time() + BOOT_SECONDS
    stopped_since = None
    while subprocess.run(ic_exec(name, 'true', user=None, timeout=10), capture_output=True).returncode:
        if time.time() > expires:
            raise RuntimeError('VM agent not ready before TTL')
        if query(f'/1.0/instances/{name}?project={PROJECT}')['status'] != 'Stopped':
            stopped_since = None
        elif stopped_since is None:
            stopped_since = time.time()
        if (stopped_since is not None and time.time() - stopped_since > STOPPED_SECONDS) or time.time() > boot_deadline:
            stopped_since = None
            if not restarts:
                raise RuntimeError('VM agent not ready after restarts')
            restarts -= 1
            subprocess.run(['incus', '--force-local', '--project', PROJECT, 'stop', name, '--force'],
                           capture_output=True)
            subprocess.run(['incus', '--force-local', '--project', PROJECT, 'start', name], capture_output=True)
            boot_deadline = time.time() + BOOT_SECONDS
        time.sleep(1)
    if network:
        code = subprocess.run(ic_exec(name, 'cloud-init', 'status', '--wait', user=None,
                                      timeout=expires - time.time()), capture_output=True).returncode
        if code not in (0, 2):
            raise RuntimeError(f'cloud-init failed in VM (exit {code})')


def pull(name, path):
    result = subprocess.run(['incus', '--force-local', '--project', PROJECT, 'file', 'pull', f'{name}{path}', '-'],
                            capture_output=True, text=True)
    return json.loads(result.stdout) if result.returncode == 0 and result.stdout.strip() else None


def destroy(name, attempts=3):
    for attempt in range(attempts):
        if attempt:
            time.sleep(5)
        subprocess.run(['incus', '--force-local', '--project', PROJECT, 'delete', name, '--force'], capture_output=True)
        info = subprocess.run(['incus', '--force-local', '--project', PROJECT, 'info', name], capture_output=True)
        if info.returncode != 0 and b'Instance not found' in info.stderr:
            return True
    return False


def lifecycle(expires):
    return '--config', f'{MANAGED}=true', '--config', f'{EXPIRES}={expires}'


def managed(vm):
    config = vm.get('config') or {}
    expires = config.get(EXPIRES, '')
    readable = expires == 'never' or expires.isdigit()
    return readable and (config.get(MANAGED) == 'true' or vm['name'].startswith('cbx-'))


def boot(name, expires, offline, *config, base=BASE):
    sync_acl()
    copy_started = time.time()
    ic('copy', base, name, *lifecycle(expires), *config)
    clone_seconds = round(time.time() - copy_started, 3)
    if offline:
        ic('config', 'device', 'add', name, 'eth0', 'none')
    isolated(name, offline)
    start = time.time()
    ic('start', name)
    wait_ready(name, expires, network=not offline)
    return dict(clone_seconds=clone_seconds, boot_seconds=round(time.time() - start, 3))


UNREADABLE = (OSError, ValueError, KeyError, TypeError, IndexError, ArithmeticError, subprocess.SubprocessError)
RESOURCE_FIELDS = ('cpus', 'memory_bytes', 'peak_rss_bytes', 'cpu_seconds', 'disk_read_bytes', 'disk_write_bytes')


def cpu_count(limit):
    """`limits.cpu` is a count such as 8 or a pinned set such as 0-3,8."""
    if limit.isdigit():
        return int(limit)
    cpus = set()
    for part in limit.split(','):
        first, _, last = part.partition('-')
        cpus.update(range(int(first), int(last or first) + 1))
    return len(cpus)


def vm_resources(name):
    """What the VM was given and used, read just before it is destroyed. A value that can't be read is null."""
    def read(path):
        return subprocess.run(['incus', '--force-local', 'query', path], check=True, capture_output=True, text=True,
                              timeout=10).stdout

    found = dict.fromkeys(RESOURCE_FIELDS)
    try:
        config = json.loads(read(f'/1.0/instances/{name}?project={PROJECT}'))['expanded_config']
    except UNREADABLE:
        config = {}
    try:
        found['cpus'] = cpu_count(config['limits.cpu'])
    except UNREADABLE:
        pass
    try:
        found['memory_bytes'] = size_bytes(config['limits.memory'])
    except UNREADABLE:
        pass
    try:
        state = json.loads(read(f'/1.0/instances/{name}/state?project={PROJECT}'))
        found['cpu_seconds'] = round(state['cpu']['usage'] / 1e9, 3)
        peak = re.search(r'^VmHWM:\s+(\d+) kB$', Path(f"/proc/{int(state['pid'])}/status").read_text(), re.M)
        found['peak_rss_bytes'] = int(peak[1]) * 1024
    except UNREADABLE:
        pass
    try:
        metrics = read(f'/1.0/metrics?project={PROJECT}')
        disk = collections.defaultdict(dict)
        for kind, device, value in re.findall(
                r'^incus_disk_(read|written)_bytes_total\{device="([^"]+)",name="' + re.escape(name) + r'",[^}]*\} (\S+)$',
                metrics, re.M):
            if re.fullmatch(r'(?!loop)[a-z]+', device):
                disk[device][kind] = int(float(value))
        if disk and all(kinds.keys() == {'read', 'written'} for kinds in disk.values()):
            found['disk_read_bytes'] = sum(kinds['read'] for kinds in disk.values())
            found['disk_write_bytes'] = sum(kinds['written'] for kinds in disk.values())
    except UNREADABLE:
        pass
    return found


def extract_artifacts(folder, max_bytes, max_files):
    folder, max_bytes, max_files, files, total = Path(folder), int(max_bytes), int(max_files), 0, 0
    with tarfile.open(fileobj=sys.stdin.buffer, mode='r|') as tar:
        for member in tar:
            inside = PurePosixPath(member.name)
            parts = [part for part in inside.parts if part != '.']
            if not member.isfile() or not parts or inside.is_absolute() or '..' in parts:
                continue
            if files == max_files or total + member.size > max_bytes:
                return
            target = folder.joinpath(*parts)
            try:
                target.parent.mkdir(parents=True, exist_ok=True)
                with tar.extractfile(member) as source, target.open('wb') as out:
                    shutil.copyfileobj(source, out)
            except BaseException:
                target.unlink(missing_ok=True)
                raise
            files, total = files + 1, total + member.size
            print(json.dumps(dict(path=str(target), bytes=member.size)), flush=True)
    print('complete', flush=True)


def copy_artifacts(name, folder):
    """Copies the regular files the job left in ARTIFACTS to folder. Returns them and whether every file was copied."""
    try:
        reader = subprocess.Popen(
            ic_exec(name, 'sh', '-c', f'mkdir -p {ARTIFACTS} && cd {ARTIFACTS} && exec tar --hard-dereference -c .'),
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return [], False
    timer = threading.Timer(ARTIFACT_SECONDS, reader.kill)
    timer.start()
    parser, lines = None, []
    try:
        parser = subprocess.run(
            ['prlimit', f'--as={ARTIFACT_MEMORY}', sys.executable, '-c',
             'import runpy, sys; runpy.run_path(sys.argv[1])["extract_artifacts"](*sys.argv[2:])',
             str(Path(__file__).resolve()), str(folder), str(ARTIFACT_BYTES), str(ARTIFACT_FILES)],
            stdin=reader.stdout, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
            timeout=ARTIFACT_SECONDS)
        lines = parser.stdout.splitlines()
    except (OSError, subprocess.TimeoutExpired):
        pass
    finally:
        complete = parser is not None and parser.returncode == 0 and lines[-1:] == ['complete']
        if not complete:
            reader.kill()
        complete = reader.wait() == 0 and complete
        timer.cancel()
        reader.stdout.close()
    return [json.loads(line) for line in lines if line.startswith('{')], complete


def job(mode, name, ttl, command, repo, sha=None, stdin=None, archive=None, offline=False, cwd=None, env=(),
        extra=None, receipts=None, on_ready=None, config=(), judge=None, clone=None):
    global ACTIVE_LOG
    CLEANUP.clear()
    receipts = Path(receipts or STATE / 'receipts')
    receipts.mkdir(parents=True, exist_ok=True)
    path, log_path = receipts / f'{name}.json', receipts / f'{name}.log'
    started = time.time()
    expires = int(started + ttl)
    receipt = dict(schema='coldbox.receipt/v1', id=name, mode=mode, repo=repo, sha=sha, verdict='incomplete',
                   host=os.uname().nodename, checks=[], started_at=now_iso(), log=str(log_path), **(extra or {}),
                   vm=dict(name=name, image=BASE, ttl_seconds=ttl, offline=offline, destroyed=False))
    write_json(path, receipt)
    guest_env = [f'COLDBOX_JOB_DIR={GUEST_JOB_DIR}', 'PIP_BREAK_SYSTEM_PACKAGES=1', *env]
    with log_path.open('ab') as log:
        ACTIVE_LOG = log_path if mode == 'runner' else None
        try:
            timing = boot(name, expires, offline, *config)
            receipt['vm']['ready_seconds'] = round(time.time() - started, 3)
            if isinstance(timing, dict):
                receipt['vm'].update(timing)
            receipt['vm']['host_ceiling'] = os.cpu_count()
            write_json(path, receipt)
            (STATE / 'ready').mkdir(parents=True, exist_ok=True)
            (STATE / 'ready' / name).touch()
            ic('file', 'push', str(Path(__file__).resolve()), f'{name}/usr/local/bin/coldbox', '--mode', '0755')
            push_guest_files(name)
            if HOST_CHECKS.exists():
                ic('file', 'push', str(HOST_CHECKS), f'{name}{HOST_CHECKS}', '--create-dirs', '--mode', '0644')
            if archive is not None:
                extract = f'mkdir -p ~/repo && tar -x -v -C ~/repo | sed "s|^|$HOME/repo/|" > {ARCHIVED}'
                subprocess.run(ic_exec(name, 'bash', '-o', 'pipefail', '-c', extract), input=archive,
                               check=True, capture_output=True)
            if clone:
                subprocess.run(ic_exec(name, 'bash', '-o', 'pipefail', '-c', CLONE, 'clone',
                                       f'https://github.com/{clone[0]}', clone[1]),
                               input=clone[2].encode(), check=True, capture_output=True)
            subprocess.run(ic_exec(name, 'touch', JOB_STARTED), check=True, capture_output=True)
            if mode == 'runner':
                admission_path = receipts / f'{name}.admission'
                receipt['admission'] = runner_admission(repo, name, expires)
                write_json(path, receipt)
                write_json(admission_path, receipt['admission'])
                ic('file', 'push', str(admission_path), f'{name}/etc/coldbox/admission.json',
                   '--create-dirs', '--mode', '0644')
                subprocess.run(ic_exec(name, 'sh', '-c', 'printf "%s\\n" "$1" > /etc/coldbox/host',
                                       'sh', receipt['admission']['host'], user=None), check=True, capture_output=True)
            if on_ready:
                on_ready()
            command_started = time.time()
            receipt['job_started_at'] = now_iso()
            write_json(path, receipt)
            code = tee(ic_exec(name, *command, cwd=cwd, env=guest_env, timeout=expires - time.time()), log, stdin)
            receipt['job_seconds'] = round(time.time() - command_started, 3)
            receipt['job_ended_at'] = now_iso()
            receipt['exit'] = code
            if judge:
                judge(receipt, log_path)
            if mode == 'runner':
                receipt['job_name'], receipt['job_result'] = job_outcome(log_path.read_bytes())
            if code in (124, 137) and time.time() >= expires - 1:
                receipt['error'] = 'TTL reached'
            github, result = pull(name, f'{GUEST_JOB_DIR}/job.json'), pull(name, f'{GUEST_JOB_DIR}/checks.json')
            if github:
                if mode == 'runner':
                    record_queue_wait(github, name)
                receipt.update(github=github, repo=github['repo'] or repo, sha=github['sha'])
            if result:
                receipt.update(checks=result['checks'], checks_verdict=result['verdict'])
            tests = subprocess.run(ic_exec(name, 'coldbox', 'junit', '--newer', JOB_STARTED,
                                           *(['--archived', ARCHIVED] if archive is not None or clone else []),
                                           *JUNIT_DIRS[mode], timeout=120),
                                   capture_output=True, text=True)
            if tests.returncode == 0:
                summary = json.loads(tests.stdout)
                ran, source = tests_ran(summary, summary.pop('cold_verify', []))
                if ran is not None:
                    receipt.update(tests_ran=ran, tests_source=source)
                if summary['total']:
                    receipt['tests'] = summary
        except subprocess.CalledProcessError as error:
            stderr = error.stderr.decode() if isinstance(error.stderr, bytes) else error.stderr or ''
            receipt['error'] = f"{' '.join(map(str, error.cmd[:7]))} failed: {stderr.strip()[-500:]}"
        except (OSError, RuntimeError, ValueError) as error:
            receipt['error'] = str(error) or type(error).__name__
        except (SystemExit, KeyboardInterrupt):
            receipt['error'] = 'stopped'
            if github := pull(name, f'{GUEST_JOB_DIR}/job.json'):
                receipt['github'] = github
            if mode == 'runner' and (assigned := running_job(log_path.read_bytes())):
                receipt['job_name'] = assigned
            raise
        finally:
            ACTIVE_LOG = None
            CLEANUP.set()
            receipt['resources'] = vm_resources(name)
            if 'job_started_at' in receipt:
                artifacts, complete = copy_artifacts(name, receipts / f'{name}.artifacts')
                if artifacts or not complete:
                    receipt.update(artifacts=artifacts, artifacts_truncated=not complete)
            destroy_started = time.time()
            gone = destroy(name)
            (STATE / 'ready' / name).unlink(missing_ok=True)
            ended = time.time()
            receipt['vm'].update(destroyed=gone, destroyed_at=now_iso(), lifetime_seconds=round(ended - started, 3),
                                 destroy_seconds=round(ended - destroy_started, 3))
            receipt['seconds'] = round(ended - started, 3)
            settle(receipt)
            write_json(path, receipt)
    print(f"coldbox: {receipt['verdict'].upper()} receipt {path}", file=sys.stderr)
    return receipt


def job_outcome(log):
    found = re.findall(rb'Job (.+) completed with result: (\w+)', log)
    return tuple(part.decode(errors='replace') for part in found[-1]) if found else (None, None)


def running_job(log):
    found = re.findall(rb'Running job: (.+)', log)
    return found[-1].decode(errors='replace').strip() if found else None


def verdict(receipt):
    if not receipt['vm']['destroyed']:
        return 'incomplete'
    if (receipt.get('github') or {}).get('refused'):
        return 'refused'
    if (receipt.get('checks_verdict') == 'fail' or receipt.get('job_result') == 'Failed'
            or (receipt.get('isolation') or {}).get('problems')):
        return 'fail'
    if receipt.get('error'):
        idle = (receipt['mode'] == 'runner' and 'github' not in receipt and not receipt.get('job_name')
                and receipt['error'] in ('TTL reached', IDLE_RELEASED, 'stopped'))
        return 'idle' if idle else 'incomplete'
    if receipt['mode'] == 'runner' and receipt.get('github'):
        if receipt.get('job_result') == 'Succeeded':
            return 'pass' if receipt.get('tests_ran') else 'incomplete'
        if receipt.get('job_result') == 'Canceled':
            return 'canceled'
    if receipt['mode'] == 'local' and receipt.get('checks_verdict') == 'pass' and receipt.get('exit') == 0:
        return 'pass' if receipt.get('tests_ran') else 'incomplete'
    if receipt['mode'] == 'adhoc' and 'exit' in receipt:
        return 'pass' if receipt['exit'] == 0 else 'fail'
    return 'incomplete'


def cause(receipt):
    if receipt['verdict'] == 'fail':
        failed = next((check['check'] for check in receipt.get('checks', []) if check['status'] == 'fail'), None)
        return failed or ('checks' if receipt.get('checks_verdict') == 'fail' else 'job')
    if receipt['verdict'] != 'incomplete':
        return None
    error = receipt.get('error')
    if error == 'stopped':
        return 'stopped'
    if 'ready_seconds' not in receipt['vm']:
        return 'vm_not_ready'
    if error:
        return 'ttl' if error == 'TTL reached' else 'infra_error'
    if not receipt['vm']['destroyed']:
        return 'vm_not_destroyed'
    return 'no_tests' if verdict(dict(receipt, tests_ran=1)) == 'pass' else 'no_result'


def settle(receipt):
    receipt['verdict'] = verdict(receipt)
    receipt.pop('cause', None)
    receipt.pop('reason', None)
    if found := cause(receipt):
        receipt['cause'] = found
    if found == 'no_tests':
        receipt['reason'] = NO_TESTS if receipt.get('tests_ran') == 0 else 'the test count could not be read'


def git(path, *args):
    return subprocess.run(['git', '-C', str(path), *args], check=True, capture_output=True).stdout


def run_local(args):
    path = Path(args.path or '.').resolve()
    sha = git(path, 'rev-parse', 'HEAD').decode().strip()
    remote = subprocess.run(['git', '-C', str(path), 'remote', 'get-url', 'origin'], capture_output=True, text=True)
    match = re.search(r'[:/]([^/:]+/[^/]+?)(\.git)?$', remote.stdout.strip())
    if git(path, 'status', '--porcelain', '--', 'coldbox.toml').strip():
        raise SystemExit('coldbox: commit coldbox.toml first; the VM runs the committed HEAD')
    plan(path)
    name, (memory, config) = new_id(), sizing(args, load_config(path / 'coldbox.toml')[2] or 'default')
    if not admit(match[1] if match else path.name, name, 'once', memory=memory):
        raise SystemExit('coldbox: the host is at its job VM ceiling; try again when a job finishes')
    receipt = job('local', name, args.ttl, ['coldbox', 'checks'], repo=match[1] if match else path.name,
                  sha=sha, archive=git(path, 'archive', '--format=tar', 'HEAD'), offline=args.offline,
                  cwd='/home/runner/repo', receipts=args.receipts, config=config)
    return exit_code(receipt)


def run_repo(args):
    if args.path is not None or args.command:
        raise SystemExit('coldbox: give --repo and --sha, a repo PATH, or -- COMMAND; not more than one')
    if not args.repo or not args.sha:
        raise SystemExit('coldbox: --repo and --sha go together')
    if args.offline:
        raise SystemExit('coldbox: --repo needs the network to clone; drop --offline')
    name, (memory, config) = new_id(), sizing(args)
    if not admit(args.repo, name, 'once', memory=memory):
        raise SystemExit('coldbox: the host is at its job VM ceiling; try again when a job finishes')
    receipt = job('local', name, args.ttl, ['coldbox', 'checks'], repo=args.repo, sha=args.sha,
                  clone=(args.repo, args.sha, repo_token(args.repo) or ''), cwd='/home/runner/repo',
                  receipts=args.receipts, config=config)
    return exit_code(receipt)


def repo_name(text):
    if not re.fullmatch(r'[A-Za-z0-9-]+/[A-Za-z0-9._-]+', text) or text.split('/')[1] in ('.', '..'):
        raise argparse.ArgumentTypeError(f'{text!r} is not OWNER/REPO')
    return text


def commit_sha(text):
    if not re.fullmatch(r'[0-9a-f]{40}', text):
        raise argparse.ArgumentTypeError(f'{text!r} is not a full 40-character lowercase commit SHA')
    return text


def run_adhoc(args):
    if args.path is not None:
        raise SystemExit('coldbox: give a repo PATH or -- COMMAND, not both')
    name, (memory, config) = new_id(), sizing(args)
    if not admit('adhoc', name, 'once', memory=memory):
        raise SystemExit('coldbox: the host is at its job VM ceiling; try again when a job finishes')
    receipt = job('adhoc', name, args.ttl, args.command, repo='adhoc', offline=args.offline, cwd=f'/home/{RUNNER}',
                  extra=dict(command=args.command), receipts=args.receipts, config=config)
    return 125 if 'error' in receipt or 'exit' not in receipt or not receipt['vm']['destroyed'] else receipt['exit']


SELFTEST_CONTROL = ('api.github.com', 443)
SELFTEST_IPV6 = ('2606:4700:4700::1111', 443)
SELFTEST_MARK = 'coldbox-selftest '
SELFTEST_GUEST = r'''
import json, os, socket, sys
