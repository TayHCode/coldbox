def isolation_probes(addresses, port):
    cgnat = ipaddress.ip_network('100.64.0.0/10')
    probes = [dict(kind='host', address=GATEWAY, port=port)]
    for interface in addresses:
        for addr in interface.get('addr_info', []):
            ip = ipaddress.ip_address(addr['local'].split('%')[0])
            if ip.is_loopback or (ip.version == 6 and ip.is_link_local):
                continue
            kind = 'ipv6' if ip.version == 6 else 'tailnet' if ip in cgnat else 'lan' if ip.is_private else 'host'
            probes.append(dict(kind=kind, address=str(ip), port=port))
    probes += [dict(kind='ipv6', address=SELFTEST_IPV6[0], port=SELFTEST_IPV6[1]),
               dict(kind='control', address=SELFTEST_CONTROL[0], port=SELFTEST_CONTROL[1])]
    unique = {}
    for probe in probes:
        unique.setdefault((probe['address'], probe['port']), dict(probe))
    return list(unique.values())


def isolation_problems(found, probes, expected):
    if not isinstance(found, dict):
        return ['the guest reported no results']
    if [(p['address'], p['port']) for p in found.get('probes', [])] != [(p['address'], p['port']) for p in probes]:
        return ['the guest did not report every probe']
    problems = []
    for probe in found['probes']:
        where = f"{probe['kind']} {probe['address']} port {probe['port']}"
        if probe['kind'] == 'control' and probe['error']:
            problems.append(f"{where} unreachable ({probe['error']}), so the blocked results prove nothing")
        elif probe['kind'] != 'control' and not probe['error']:
            problems.append(f'{where} was reachable')
        elif probe['kind'] == 'ipv6' and probe['errno'] != errno.ENETUNREACH:
            problems.append(f"{where} failed with {probe['error']}, not network unreachable, so the VM may route IPv6")
    if found['cpus'] != expected['cpus']:
        problems.append(f"nproc is {found['cpus']}, not the profile's {expected['cpus']}")
    if found['memory_bytes'] > expected['memory_bytes']:
        problems.append(f"MemTotal is {found['memory_bytes']} bytes, above the profile's {expected['memory_bytes']}")
    if found['disk_bytes'] > expected['disk_bytes']:
        problems.append(f"the root disk is {found['disk_bytes']} bytes, above the profile's {expected['disk_bytes']}")
    if found['write_errno'] != errno.ENOSPC:
        outcome = 'succeeded' if found['write_errno'] is None else f"failed with errno {found['write_errno']}, not ENOSPC"
        problems.append(f"a {expected['write_bytes'] / 2**30:g} GiB write {outcome}")
    return problems


def selftest_listener():
    try:
        sock = socket.socket(socket.AF_INET6, socket.SOCK_STREAM)
        sock.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        sock.bind(('::', 0))
    except OSError:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.bind(('0.0.0.0', 0))
    sock.listen(64)
    return sock


def selftest(args):
    expected = dict(cpus=cpu_count(ic('profile', 'get', 'coldbox', 'limits.cpu').strip()), memory_bytes=vm_memory(),
                    disk_bytes=vm_disk(), write_bytes=vm_disk() + 2**30)
    name = new_id()
    if not admit('selftest', name, 'once'):
        raise SystemExit('coldbox: the host is at its job VM ceiling; try again when a job finishes')
    with selftest_listener() as listener:
        probes = isolation_probes(host_addresses(), listener.getsockname()[1])

        def judge(receipt, log_path):
            found = None
            for line in log_path.read_text(errors='replace').splitlines():
                if line.startswith(SELFTEST_MARK):
                    found = json.loads(line.removeprefix(SELFTEST_MARK))
            receipt['isolation'] = dict(expected=expected, found=found,
                                        problems=isolation_problems(found, probes, expected))

        receipt = job('adhoc', name, args.ttl, ['python3', '-c', SELFTEST_GUEST], repo='selftest',
                      stdin=json.dumps(dict(probes=probes, write_bytes=expected['write_bytes'])).encode(),
                      cwd=f'/home/{RUNNER}', extra=dict(command=['coldbox', 'selftest', 'isolation']),
                      receipts=args.receipts, judge=judge)
    for problem in (receipt.get('isolation') or {}).get('problems', []):
        print(f'coldbox selftest: FAIL {problem}', file=sys.stderr)
    return exit_code(receipt)


def sizing(args, size='default'):
    if args.memory and size_bytes(args.memory) > vm_memory():
        raise SystemExit(f"coldbox: --memory {args.memory} is above the coldbox profile's limits.memory; "
                         'it can only shrink a VM')
    memory, limits = vm_shape(size)
    limits.update({key: value for key, value in (('limits.cpu', args.cpus), ('limits.memory', args.memory)) if value})
    return size_bytes(args.memory) if args.memory else memory, incus_config(limits)


def vm_shape(size):
    """The memory admit() reserves for a VM of this size (None: the coldbox profile's) and its limits. small halves the
    profile's vCPUs and memory; large doubles them, up to this host's CPU threads and what one VM may take here."""
    if size == 'default':
        return None, {}
    memory, cpus = vm_memory(), cpu_count(ic('profile', 'get', 'coldbox', 'limits.cpu').strip())
    if size == 'small':
        cpus, memory = max(1, cpus // 2), memory // 2
    else:
        cpus, memory = max(cpus, min(2 * cpus, os.cpu_count())), large_memory(memory, host_memory())
    mib = memory // 2**20
    return mib * 2**20, {'limits.cpu': str(cpus), 'limits.memory': f'{mib}MiB'}


def incus_config(limits):
    return [arg for key, value in limits.items() for arg in ('--config', f'{key}={value}')]


def adhoc_vms():
    return {vm['name']: vm for vm in json.loads(ic('list', '--format', 'json'))
            if vm['name'].startswith('cbx-') and (vm.get('config') or {}).get(ADHOC) == 'true'}


def vm_cmd(args):
    if args.action == 'up':
        try:
            policy = fleet()
        except RuntimeError as error:
            raise SystemExit(f'coldbox: {error}') from error
        if policy and policy[0] == os.uname().nodename:
            raise SystemExit(f'coldbox: this host is the CI primary in {CI_HOSTS}; run ad-hoc VMs on another host')
        name, refusal = new_id(), 'coldbox: the host is at its job VM ceiling; try again when a job finishes'
        try:
            admitted = admit('vm', name, 'vm')
        except SystemExit as limit:
            admitted, refusal = False, str(limit)
        if not admitted:
            command = ['coldbox', 'vm', 'up', '--here', '--ttl', str(args.ttl)] + ['--offline'] * args.offline
            tags = collections.Counter(map(host_tag, [os.uname().nodename, *adhoc_peers()]))
            peers = [] if args.here else [peer for peer in adhoc_peers() if tags[host_tag(peer)] == 1]
            ranked = least_loaded(peers, None)
            for host in ranked + [peer for peer in peers if peer not in ranked]:
                started = subprocess.run(ssh(host, command), stdout=subprocess.PIPE, text=True)
                if started.returncode == 0:
                    print(f'coldbox: {refusal.removeprefix("coldbox: ")}; started it on {host}', file=sys.stderr)
                    print(started.stdout.strip())
                    return 0
            raise SystemExit(refusal)
        try:
            boot(name, int(time.time() + args.ttl), args.offline, '--config', f'{ADHOC}=true')
        except BaseException:
            destroy(name)
            raise
        print(name)
        return 0
    vms = adhoc_vms()
    if args.action == 'list':
        for vm in vms.values():
            left = int(vm['config'].get('user.coldbox.expires', 0)) - time.time()
            print(f"{vm['name']}\t{vm['status']}\texpires in {max(0, left) / 60:.0f} min")
        return 0
    if args.name not in vms:
        tag = args.name.split('-', 3)[3:]
        homes = [peer for peer in adhoc_peers() if tag == [host_tag(peer)]]
        if len(homes) != 1 or tag == [host_tag(os.uname().nodename)]:
            raise SystemExit(f'coldbox: no ad-hoc VM named {args.name}; see coldbox vm list')
        home = homes[0]
        forwarded = ['coldbox', 'vm', args.action, args.name] + (['--', *args.command] if args.action == 'exec' else [])
        return subprocess.run(ssh(home, forwarded)).returncode
    if args.action == 'down':
        gone = destroy(args.name)
        print(f"coldbox: {args.name} {'deleted' if gone else 'FAILED to delete'}", file=sys.stderr)
        return 0 if gone else 1
    left = int(vms[args.name]['config']['user.coldbox.expires']) - time.time()
    if left <= 0:
        raise SystemExit(f'coldbox: {args.name} has expired; the reaper will delete it')
    return subprocess.run(ic_exec(args.name, *args.command, cwd=f'/home/{RUNNER}', timeout=left)).returncode


def app_jwt(app_id, key=None):
    encode = lambda value: base64.urlsafe_b64encode(value).rstrip(b'=')
    now = int(time.time())
    payload = {'iat': now - 60, 'exp': now + 540, 'iss': app_id}
    message = b'.'.join(encode(json.dumps(value).encode())
                        for value in ({'alg': 'RS256', 'typ': 'JWT'}, payload))
    signed = subprocess.run(['openssl', 'dgst', '-sha256', '-sign', str(key or APP_KEY)], input=message,
                            capture_output=True, timeout=30)
    if signed.returncode:
        raise RuntimeError('GitHub App: RS256 signing failed; check private key access')
    return (message + b'.' + encode(signed.stdout)).decode()


def app_request(path, jwt, method='GET', body=None):
    request = urllib.request.Request(f'https://api.github.com/{path}', method=method,
                                    data=json.dumps(body or {}).encode() if method == 'POST' else None,
                                    headers={'Authorization': f'Bearer {jwt}', 'User-Agent': 'coldbox',
                                             'Accept': 'application/vnd.github+json',
                                             'X-GitHub-Api-Version': '2022-11-28'})
    with urllib.request.urlopen(request, timeout=60) as response:
        return json.load(response)


def app_token(path='', scope=None):
    try:
        config = dict(line.strip().split('=', 1) for line in APP_ENV.read_text().splitlines()
                      if line.strip().startswith('COLDBOX_GITHUB_APP_ID=')) if APP_ENV.exists() else {}
        app_id = os.environ.get('COLDBOX_GITHUB_APP_ID') or config.get('COLDBOX_GITHUB_APP_ID')
        if not app_id or not APP_KEY.exists():
            return None
        if not app_id.isdecimal():
            raise RuntimeError('GitHub App: COLDBOX_GITHUB_APP_ID must be numeric')
        match = re.match(r'(?:repos|orgs|users)/([^/?]+)', path)
        owner = match[1].casefold() if match else ''
        with APP_LOCK:
            cache_key = (app_id, owner, json.dumps(scope))
            cached = APP_TOKENS.get(cache_key)
            if cached and time.time() < cached[1] - 300:
                return cached[0]
            jwt = app_jwt(app_id)
            installations, page = [], 1
            while True:
                batch = app_request(f'app/installations?per_page=100&page={page}', jwt)
                installations.extend(batch)
                if len(batch) < 100:
                    break
                page += 1
            matches = [item for item in installations if not owner or item['account']['login'].casefold() == owner]
            if not matches or owner and len(matches) != 1:
                raise RuntimeError('GitHub App: no unique installation for the target owner')
            token = app_request(f"app/installations/{matches[0]['id']}/access_tokens", jwt, 'POST', scope)
            expires = datetime.fromisoformat(token['expires_at'].replace('Z', '+00:00')).timestamp()
            if not isinstance(token['token'], str) or not token['token'] or expires <= time.time() + 300:
                raise RuntimeError('GitHub App: invalid or expired installation token')
            APP_TOKENS[cache_key] = token['token'], expires
            return token['token']
    except urllib.error.HTTPError as error:
        kind = GitHubTransient if 500 <= error.code < 600 else RuntimeError
        raise kind(f'GitHub App authentication failed: HTTP {error.code}') from None
    except (urllib.error.URLError, TimeoutError, ConnectionError):
        raise GitHubTransient('GitHub App authentication failed: network error') from None
    except RuntimeError:
        raise
    except Exception:
        raise RuntimeError('GitHub App authentication failed; check configuration, key and connectivity') from None


def repo_token(repo):
    try:
        token = app_token(f'repos/{repo}', dict(repositories=[repo.split('/')[1]], permissions=dict(contents='read')))
    except RuntimeError as error:
        if 'HTTP 422' not in str(error) and 'no unique installation' not in str(error):
            raise
        token = None
    if token is None:
        print(f'coldbox: no GitHub App token can read {repo} (the App needs Contents: read on that repo); '
              'cloning anonymously, which works only for public repos', file=sys.stderr, flush=True)
    return token


APP_PERMISSIONS = dict(administration='write', actions='read', metadata='read')
ORG_APP_PERMISSIONS = dict(APP_PERMISSIONS, organization_self_hosted_runners='write')


def setup_app(args):
    if args.app_id is None and args.key is None:
        query = urllib.parse.urlencode(dict(name=f'coldbox-{os.uname().nodename}', url='https://github.com/TayHCode/coldbox',
                                            public='false', webhook_active='false',
                                            **(ORG_APP_PERMISSIONS if args.org else APP_PERMISSIONS)))
        owner = f'organizations/{urllib.parse.quote(args.org)}/settings' if args.org else 'settings'
        print(f'1. Open https://github.com/{owner}/apps/new?{query}')
        print('   The form is filled in with only the permissions Coldbox needs. Click "Create GitHub App".')
        print('2. Note the App ID, then click "Generate a private key" and copy the .pem file to this host.')
        print(f"3. sudo coldbox setup-app{f' --org {args.org}' if args.org else ''} --app-id <App ID> --key <path to .pem>")
        return 0
    if args.app_id is None or args.key is None:
        raise ConfigError('setup-app: give both --app-id and --key, or neither to print the setup steps')
    if not args.app_id.isdecimal():
        raise ConfigError('setup-app: --app-id must be the numeric App ID')
    if os.geteuid() != 0:
        raise SystemExit('coldbox setup-app: run with sudo')
    if APP_KEY.exists() or APP_ENV.exists():
        raise ConfigError(f'setup-app: GitHub App auth is already configured; remove {APP_KEY} and {APP_ENV} to replace it')
    key = Path(args.key)
    try:
        app = app_request('app', app_jwt(args.app_id, key))
    except urllib.error.HTTPError as error:
        raise RuntimeError(f'setup-app: GitHub rejected App ID {args.app_id} with this key (HTTP {error.code})') from None
    except (urllib.error.URLError, TimeoutError, ConnectionError):
        raise RuntimeError('setup-app: could not reach api.github.com') from None
    granted = app.get('permissions', {})
    wanted = ORG_APP_PERMISSIONS if args.org else APP_PERMISSIONS
    extra = sorted(f'{name}:{level}' for name, level in granted.items()
                   if level not in {'read': ('read',), 'write': ('read', 'write')}.get(wanted.get(name), ()))
    missing = sorted(f'{name}:{level}' for name, level in wanted.items()
                     if granted.get(name) != level)
    if extra or missing:
        raise ConfigError('setup-app: change the App\'s permissions in its settings and run this again: '
                          + '; '.join(f"{label} {', '.join(items)}" for label, items in
                                      (('remove', extra), ('add', missing)) if items))
    owner = pwd.getpwnam(os.environ.get('SUDO_USER') or 'root')
    APP_KEY.parent.mkdir(parents=True, exist_ok=True)
    pem = key.read_bytes()
    descriptor = os.open(APP_KEY, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, 'wb') as out:
            out.write(pem)
        os.chown(APP_KEY, owner.pw_uid, owner.pw_gid)
        APP_ENV.write_text(f'COLDBOX_GITHUB_APP_ID={args.app_id}\n')
        APP_ENV.chmod(0o644)
    except BaseException:
        APP_KEY.unlink(missing_ok=True)
        APP_ENV.unlink(missing_ok=True)
        raise
    print(f"GitHub App {app['slug']} configured: {APP_KEY} (mode 600, owner {owner.pw_name}) and {APP_ENV}")
    print(f"Next: install it on the repos to register at https://github.com/apps/{app['slug']}/installations/new")
    return 0


def gh_env(path=''):
    token = app_token(path)
    return dict(os.environ, GH_TOKEN=token, GH_HOST='github.com') if token else None


def gh(*args, body=None, _retries=None):
    command = ['gh', 'api', *args] + (['--input', '-'] if body is not None else [])
    path = next((arg for arg in args if arg.startswith(('repos/', 'orgs/', 'users/'))), '')
    retries = [4] if _retries is None else _retries
    pending_jit = False
    runner_delete = '-X' in args and 'DELETE' in args and '/actions/runners/' in path
    ambiguous_delete = False
    while True:
        sent = False
        try:
            if pending_jit:
                reconcile_jit(path.removesuffix('/generate-jitconfig'), body['name'], retries)
                pending_jit = False
            env = gh_env(path)
            try:
                sent = True
                result = subprocess.run(command, env=env, input=json.dumps(body) if body is not None else None,
                                        capture_output=True, text=True, timeout=60)
            except subprocess.TimeoutExpired:
                raise GitHubTransient('GitHub request timed out') from None
            if not result.returncode:
                return json.loads(result.stdout) if result.stdout.strip() else None
            detail = result.stderr.strip() or result.stdout.strip()
            status = re.search(r'HTTP ([0-9]{3})', detail)
            if status and status[1] == '404' and runner_delete and ambiguous_delete:
                return None
            transient = (500 <= int(status[1]) < 600) if status else bool(re.search(
                r'(?i)no server is currently available|dial tcp|timeout|timed out|connection reset|'
                r'connection refused|\bEOF\b|TLS handshake|network is unreachable|temporary failure|error connecting', detail))
            if env:
                detail = f"GitHub App request failed: {status[0] if status else 'unknown HTTP status'}"
            kind = GitHubTransient if transient else RuntimeError
            raise kind(f'gh api {" ".join(args)}: {detail}')
        except GitHubTransient:
            ambiguous_delete = ambiguous_delete or sent and runner_delete
            if sent and path.endswith('/generate-jitconfig') and body is not None:
                pending_jit = True
            if not retries[0]:
                if sent and pending_jit:
                    reconcile_jit(path.removesuffix('/generate-jitconfig'), body['name'], retries)
                raise
            delay = 2 ** (4 - retries[0])
            retries[0] -= 1
            time.sleep(delay)


def reconcile_jit(path, name, retries):
    page = 1
    while True:
        runners = gh(f'{path}?per_page=100&page={page}', _retries=retries)['runners']
        for runner in runners:
            if runner['name'] == name:
                if runner['busy']:
                    raise RuntimeError(f'cannot retry JIT registration: runner {name} is busy')
                gh('-X', 'DELETE', f"{path}/{runner['id']}", _retries=retries)
        if len(runners) < 100:
            return
        page += 1


def scope(target):
    if not TARGET.fullmatch(target):
        raise SystemExit(f'coldbox: {target!r} is not OWNER/REPO or ORG')
    return f'repos/{target}' if '/' in target else f'orgs/{target}'


def guard(target, allow_public):
    """Refuse a target Coldbox must not serve. For an opted-in public repo, return the users whose jobs run without
    approval; for a private one, None."""
    if '/' in target:
        repo = gh(scope(target))
        if str(repo.get('full_name')).casefold() != target.casefold():
            raise SystemExit(f"coldbox: refusing: {target} now resolves to {repo.get('full_name')}")
        if repo['visibility'] == 'private':
            return None
        what = f'{target} is not a private repository'
    else:
        if not gh(f'orgs/{target}/actions/runner-groups/1')['allows_public_repositories']:
            return None
        what = f"org {target}'s default runner group allows public repositories"
    if not allow_public:
        raise SystemExit(f'coldbox: refusing: {what}. On a public repository anyone can open a pull request. Pass '
                         '--allow-public to serve it: jobs from users with write access then run at once, and '
                         "everyone else's pull requests wait until you approve them on GitHub.")
    if '/' not in target:
        raise SystemExit('coldbox: refusing: --allow-public is per repository; register OWNER/REPO')
    try:
        return public_writers(gh, target, repo)
    except ValueError as error:
        raise SystemExit(f'coldbox: refusing: {error}') from None


def public_writers(get, target, repo):
    if (repo.get('owner') or {}).get('type') != 'User':
        raise Unsafe(f'{target} is owned by an organization, whose members can skip GitHub\'s approval of '
                         'outside pull requests; --allow-public serves only repos owned by a user account')
    policy = get(f'repos/{target}/actions/permissions/fork-pr-contributor-approval').get('approval_policy')
    if policy != APPROVAL:
        raise Unsafe(f'{target} runs some outside pull requests without approval (approval_policy {policy}). '
                     f'Fix: gh api -X PUT repos/{target}/actions/permissions/fork-pr-contributor-approval '
                     f'-f approval_policy={APPROVAL}')
    writers, page = [], 1
    while True:
        batch = get(f'repos/{target}/collaborators?permission=push&per_page=100&page={page}')
        writers += [user['login'] for user in batch]
        if len(batch) < 100:
            return sorted(writers)
        page += 1


def stop_once(*_):
    if not DRAINING.is_set() and ACTIVE_LOG is not None:
        try:
            log = ACTIVE_LOG.read_bytes()
        except OSError:
            log = b''
        if running_job(log) and job_outcome(log) == (None, None):
            DRAINING.set()
            return
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    sys.exit(143)


def exit_code(receipt):
    return {'pass': 0, 'fail': 1}.get(receipt['verdict'], 125)


def worker_argv(args, *extra):
    argv = [sys.executable, str(Path(__file__).resolve()), 'serve', args.target, '--worker', '--ttl', str(args.ttl),
            '--slots', str(min(args.slots, 1))]
    return argv + ['--allow-public'] * args.allow_public + ['--allow-forks'] * args.allow_forks + list(extra)


def serve_slots(args):
    children = [subprocess.Popen(worker_argv(args, *['--once'] * args.once)) for _ in range(args.slots)]
    bursts = []
    STOPPING.clear()
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, lambda *_: [STOPPING.set()] + [child.send_signal(signal.SIGTERM)
                                                               for child in children + bursts if child.poll() is None])
    if args.once:
        return max(child.wait() for child in children)
    github = GitHub() if '/' in args.target else None
    next_pass = 0
    while not STOPPING.is_set() and all(child.poll() is None for child in children):
        if github and time.time() >= next_pass:
            started = time.time()
            next_pass = started + AUTOSCALE_SECONDS
            try:
                next_pass = started + autoscale(github, args, bursts)
            except (OSError, RuntimeError, ValueError, KeyError, subprocess.SubprocessError) as error:
                print(f'coldbox: autoscale pass failed: {type(error).__name__}: {error}', file=sys.stderr, flush=True)
        time.sleep(1)
    if not STOPPING.is_set():
        for child in children + bursts:
            if child.poll() is None:
                child.send_signal(signal.SIGTERM)
    return max((child.wait() for child in children + bursts), default=143) or 1


def release_idle(target, runner_id):
    if CLEANUP.is_set():
        return
    try:
        gh('-X', 'DELETE', f'{scope(target)}/actions/runners/{runner_id}')
    except RuntimeError as error:
        if 'HTTP 422' not in str(error):
            retry = threading.Timer(60, release_idle, (target, runner_id))
            retry.daemon = True
            retry.start()
        return
    os.kill(os.getpid(), signal.SIGUSR1)


def idle_released(*_):
    if not CLEANUP.is_set():
        raise RuntimeError(IDLE_RELEASED)


def serve(args):
    _, primary = ci_host()
    if not args.worker and (args.slots > 1 or not args.once):
        return serve_slots(args)
    signal.signal(signal.SIGTERM, stop_once)
    signal.signal(signal.SIGUSR1, idle_released)
    env = ['ACTIONS_RUNNER_HOOK_JOB_STARTED=/opt/coldbox-job-started.sh',
           f'COLDBOX_CI_PRIMARY={primary}']
    if args.allow_forks:
        env.append('COLDBOX_ALLOW_FORKS=1')
    memory, limits = vm_shape(args.size)
    labels = runner_labels(args.size)
    while True:
        writers = guard(args.target, args.allow_public)
        name = args.name or new_id()
        if args.idle:
            note_worker(os.getpid(), args.target, name, 'burst', writers, memory)
        elif not admit(args.target, name, 'base' if args.worker and not args.once else 'once', writers, memory):
            if args.once:
                raise SystemExit('coldbox: the host is at its job VM ceiling; not starting another')
            print('coldbox: the host is at its job VM ceiling; waiting', file=sys.stderr, flush=True)
            time.sleep(30)
            continue
        if not args.once and compile(Path(__file__).read_bytes(), __file__, 'exec') != LOADED_CODE:
            extra = (['--idle', str(args.idle)] if args.idle else []) + (['--name', args.name] if args.name else []) + \
                (['--size', args.size] if args.size != 'default' else [])
            os.execv(sys.executable, worker_argv(args, *extra))
        admission = runner_admission(args.target, name, time.time() + args.ttl)
        (STATE / 'receipts').mkdir(parents=True, exist_ok=True)
        marker = STATE / 'receipts' / f'{name}.registered'
        marker.touch()
        try:
            runner = gh('-X', 'POST', f'{scope(args.target)}/actions/runners/generate-jitconfig',
                        body=dict(name=name, runner_group_id=1, labels=labels, work_folder='_work'))
        except GitHubTransient:
            raise
        except RuntimeError:
            marker.unlink(missing_ok=True)
            raise
        idle = threading.Timer(args.idle, release_idle, (args.target, runner['runner']['id'])) if args.idle else None
        try:
            if idle:
                idle.daemon = True
            print(f'coldbox: runner {name} waiting for a job on {args.target}', file=sys.stderr, flush=True)
            receipt = job('runner', name, args.ttl, ['sh', '-c', 'read -r c; exec ./run.sh --jitconfig "$c"'],
                          repo=args.target, stdin=(runner['encoded_jit_config'] + '\n').encode(),
                          cwd='/opt/actions-runner',
                          env=env + ([f"COLDBOX_PUBLIC_WRITERS={','.join(writers)}"] if writers is not None else []),
                          extra=dict(runner_id=runner['runner']['id'], admission=admission),
                          on_ready=idle.start if idle else None, config=incus_config(limits))
        finally:
            if idle:
                idle.cancel()
            try:
                gh('-X', 'DELETE', f"{scope(args.target)}/actions/runners/{runner['runner']['id']}")
            except RuntimeError:
                pass
        if DRAINING.is_set():
            return 143
        if args.once:
            return exit_code(receipt)
        if 'job_seconds' not in receipt:
            time.sleep(30)


class GitHub:
    def __init__(self):
        self.cache, self.used = {}, set()
        self.remaining, self.reset = None, 0

    def get(self, path):
        if self.remaining is not None and self.remaining < QUOTA_RESERVE and time.time() < self.reset:
            raise RuntimeError(f'GitHub API quota low ({self.remaining} left); waiting for its reset')
        token = app_token(path) or subprocess.run(['gh', 'auth', 'token'], capture_output=True, text=True, check=True,
                               timeout=60).stdout.strip()
        headers = {'Authorization': f'Bearer {token}', 'Accept': 'application/vnd.github+json',
                   'X-GitHub-Api-Version': '2022-11-28', 'User-Agent': 'coldbox'}
        self.used.add(path)
        if path in self.cache:
            headers['If-None-Match'] = self.cache[path][0]
        request = urllib.request.Request(f'https://api.github.com/{path}', headers=headers)
        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                self.note(response.headers)
                value = json.loads(response.read())
                if response.headers.get('ETag'):
                    self.cache[path] = (response.headers['ETag'], value)
                return value
        except urllib.error.HTTPError as error:
            self.note(error.headers)
            if error.code == 304 and path in self.cache:
                return self.cache[path][1]
            raise RuntimeError(f'GET {path}: HTTP {error.code}') from None

    def note(self, headers):
        if headers and headers.get('X-RateLimit-Remaining') is not None:
            self.remaining = int(headers['X-RateLimit-Remaining'])
            self.reset = int(headers.get('X-RateLimit-Reset', 0))

    def forget_unused(self):
        self.cache = {path: entry for path, entry in self.cache.items() if path in self.used}
        self.used = set()


def listing(github, path, key):
    items, page = [], 1
    while True:
        batch = github.get(f'{path}per_page=100&page={page}')[key]
        items += batch
        if len(batch) < 100:
            return items
        page += 1


def runner_labels(size):
    return LABELS if size == 'default' else LABELS[:-1] + [f'coldbox-{size}']


def job_size(labels):
    labels = {label.casefold() for label in labels}
    return next((size for size in SIZES if labels and labels <= set(runner_labels(size))), None)


def runs_here(labels):
    return job_size(labels) is not None


def queued_jobs(github, repo, older_than=0, writers=None):
    runs = [run for status in ('queued', 'in_progress', 'pending')
            for run in listing(github, f'repos/{repo}/actions/runs?status={status}&', 'workflow_runs')]
    if writers is not None:
        runs = [run for run in runs if not held(run, repo, writers)]
    now = time.time()
    jobs = [job for run in runs
            for job in listing(github, f"repos/{repo}/actions/runs/{run['id']}/jobs?", 'jobs')
            if job['status'] == 'queued' and runs_here(job['labels'])]
    eligible = [job for job in jobs if not older_than or queued_at(job) <= now - older_than]
    oldest = max((max(0, now - queued_at(job)) for job in eligible if job.get('created_at')), default=0)
    return len(eligible), int(oldest), collections.Counter(job_size(job['labels']) for job in eligible)


def observe_queue(github, repo, writers=None):
    threshold = int(os.environ.get('COLDBOX_QUEUE_STALL_SECONDS', '300'))
    if threshold <= 0:
        raise ValueError('COLDBOX_QUEUE_STALL_SECONDS must be positive')
    count, oldest, sizes = queued_jobs(github, repo, writers=writers)
    path = STATE / 'queues' / f'{repo}.json'
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        try:
            previous = json.loads(path.read_text())
        except (FileNotFoundError, ValueError):
            previous = {}
        stalled = bool(count) and oldest >= threshold
        observation = dict(queued=count, oldest_wait_seconds=oldest, stalled=stalled,
                           observed_at=now_iso(), threshold_seconds=threshold)
        write_json(path, observation)
        if stalled != previous.get('stalled', False):
            print(f"coldbox: queue {'STALLED' if stalled else 'CLEARED'} on {repo}; "
                  f'{count} queued job(s); oldest waited {oldest} s', file=sys.stderr, flush=True)
    except OSError as error:
        print(f'coldbox: queue observation unavailable on {repo}: {error}', file=sys.stderr, flush=True)
    return count, oldest, sizes


def held(run, repo, writers):
    head = (run.get('head_repository') or {}).get('full_name') or ''
    actor = (run.get('triggering_actor') or run.get('actor') or {}).get('login')
    why = outsider(run.get('event'), head.casefold() != repo.casefold(), actor, writers)
    if why:
        print(f"coldbox: not scaling for run {run['id']} on {repo}: {why}", file=sys.stderr, flush=True)
    return why


def queued_at(job):
    return datetime.fromisoformat(job['created_at'][:19]).replace(tzinfo=timezone.utc).timestamp()


def host_setting(path, unit):
    try:
        text = path.read_text().strip()
    except FileNotFoundError:
        return 0
    if not text.isdigit():
        raise ValueError(f'{path} must hold a whole number of {unit}, not {text!r}')
    return int(text)


def host_cpu_load():
    cpus = os.cpu_count()
    try:
        samples = []
        for index in range(2):
            if index:
                time.sleep(1)
            fields = Path('/proc/stat').read_text().splitlines()[0].split()
            if fields[0] != 'cpu' or len(fields) < 9:
                raise ValueError('invalid aggregate CPU counters')
            counters = [int(value) for value in fields[1:9]]
            if any(value < 0 for value in counters):
                raise ValueError('negative CPU counter')
            samples.append(counters)
        delta = [end - start for start, end in zip(*samples)]
        total = sum(delta)
        if any(value < 0 for value in delta) or not total:
            raise ValueError('invalid CPU counter delta')
        return cpus * (1 - delta[3] / total)
    except (OSError, ValueError, IndexError):
        return max(os.getloadavg()[0], cpus)


def ramp_room(add, running, now=None):
    try:
        cap = json.loads((STATE / 'ramp-cap.json').read_text())
    except FileNotFoundError:
        return add
    except (OSError, ValueError) as error:
        raise ValueError(f"invalid ramp cap: {STATE / 'ramp-cap.json'}") from error
    if (not isinstance(cap, dict) or type(cap.get('limit')) is not int or cap['limit'] < 0
            or ('expires' not in cap)
            or (cap['expires'] is None and not re.fullmatch(r'[a-f0-9]{64}', str(cap.get('evidence', ''))))
            or (cap['expires'] is not None and (type(cap['expires']) not in (int, float)
                                              or not math.isfinite(cap['expires'])))):
        raise ValueError(f"invalid ramp cap: {STATE / 'ramp-cap.json'}")
    if cap['expires'] is not None and cap['expires'] <= (time.time() if now is None else now):
        return add
    return max(0, min(add, cap['limit'] - running))


def rooms(vms, cpus, load, available, floor, vm_memory, reserve=0, ceiling=math.inf):
    """The one admission rule, for every job VM on every host: room for more VMs by each check. ceiling is how many
    more fit when every job VM, idle or busy, uses CORES_PER_JOB of the threads left after the reserve and grows to
    its full memory; an idle VM that takes a job only changes state, so a rush of jobs onto idle VMs never passes
    it. available is real MemAvailable less VMs still booting. The load already counts the other work, so the
    reserve only caps the VMs."""
    return dict(ceiling=min((cpus - reserve) // CORES_PER_JOB - vms, ceiling), memory=(available - floor) // vm_memory,
                load=int(cpus - load))


def burst_count(wanted, room):
    """How many job VMs to start for wanted queued jobs under the admission rule."""
    return max(0, min(wanted, *room.values()))


def declined(room):
    return min(room, key=room.get)


