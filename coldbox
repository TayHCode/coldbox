SAME_REPO_EVENTS = {'push', 'workflow_dispatch', 'schedule', 'repository_dispatch', 'release', 'create', 'delete'}
JUNIT_DIRS = dict(local=[f'{GUEST_JOB_DIR}/junit', f'/home/{RUNNER}/repo'],
                  runner=[f'{GUEST_JOB_DIR}/junit', '/opt/actions-runner/_work'])
JUNIT_STATUS = (('failure', 'failed'), ('error', 'error'), ('skipped', 'skipped'))
MAX_TEST_RESULTS = 5000
JOB_STARTED = f'{GUEST_JOB_DIR}/started'
ARCHIVED = f'{GUEST_JOB_DIR}/archived'
