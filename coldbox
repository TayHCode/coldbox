        print(f"  {r['id']:24} {r['verdict']:10} {r['repo'] or '':32} {r.get('seconds', 0):6.0f}s  {r['started_at']}{queue_text}")
    if not receipts:
        print('  none')
    return 1 if failures else 0


def vcpus(text):
    if not re.fullmatch(r'[1-9]\d*', text) or int(text) > os.cpu_count():
        raise argparse.ArgumentTypeError(f'use a vCPU count from 1 to {os.cpu_count()}, not {text!r}')
    return int(text)


def vm_size(text):
    if not re.fullmatch(r'[1-9]\d{0,6}(MiB|GiB)', text):
        raise argparse.ArgumentTypeError(f'use a size such as 8GiB or 512MiB, not {text!r}')
    return text


def window(text):
    match = re.fullmatch(r'([1-9]\d*)([smhd])', text)
    if not match:
        raise argparse.ArgumentTypeError(f'use a duration such as 30m, 1h or 7d, not {text!r}')
    return int(match[1]) * dict(s=1, m=60, h=3600, d=86400)[match[2]]


def at(text):
    return datetime.fromisoformat(text).timestamp()


def spread(values):
    values = sorted(values)
    rank = lambda share: values[max(0, math.ceil(share * len(values)) - 1)]
    return dict(n=len(values), p50=rank(.5), p90=rank(.9), max=values[-1]) if values else dict(n=0)


def ran_job(receipt):
    if receipt.get('mode') == 'runner':
        return bool(receipt.get('github')) and not receipt['github'].get('refused')
    return 'exit' in receipt


def job_span(receipt, now=None):
    github = receipt.get('github') or {}
    try:
        if now is not None and running(receipt):
            if receipt['mode'] == 'runner':
                found = re.findall(rb'^(\d{4}-\d\d-\d\d) (\d\d:\d\d:\d\d)Z: Running job', Path(receipt['log']).read_bytes(),
                                   re.M)
                return (at(f'{found[-1][0].decode()}T{found[-1][1].decode()}+00:00'), now) if found else None
            return at(receipt['job_started_at']), now
        if receipt['mode'] == 'runner':
            return at(github['runner_started_at']), at(github.get('completed_at') or receipt['job_ended_at'])
        return at(receipt['job_started_at']), at(receipt['job_ended_at'])
    except (KeyError, TypeError, ValueError, OSError):
        return None


def job_wall(receipt):
    span = job_span(receipt)
    if span:
        return round(span[1] - span[0], 3)
    return receipt.get('job_seconds') if receipt.get('mode') != 'runner' else None


STAT_METRICS = dict(queue_wait=lambda r: (r.get('github') or {}).get('queue_wait_seconds'),
                    boot_to_ready=lambda r: (r.get('vm') or {}).get('ready_seconds'),
                    job_wall=job_wall)


def job_stats(jobs):
    found = dict(jobs=len(jobs))
    for metric, read in STAT_METRICS.items():
        values = [value for value in map(read, jobs) if type(value) in (int, float)]
        found[metric] = dict(spread(values), missing=len(jobs) - len(values))
    return found


def step_times(receipt):
    steps = (receipt.get('github') or {}).get('steps') or []
    return ([(step.get('name'), step.get('seconds')) for step in steps] +
            [(f"checks/{check.get('check')}", check.get('seconds')) for check in receipt.get('checks') or []])


def most_at_once(spans):
    edges = sorted([(start, 1) for start, _ in spans] + [(end, -1) for _, end in spans])
    now = best = 0
    for _, change in edges:
        now += change
        best = max(best, now)
    return best


def running(receipt):
    return 'seconds' not in receipt and not (receipt.get('vm') or {}).get('destroyed')


def vm_span(receipt, now):
    start, vm = at(receipt['started_at']), receipt.get('vm') or {}
    if not vm.get('destroyed'):
        return start, now
    return start, at(vm['destroyed_at']) if vm.get('destroyed_at') else start + receipt['seconds']


def job_start(receipt, now):
    """When the job started, or None for a VM that never got one."""
    try:
        if receipt['mode'] == 'runner' and (receipt.get('github') or {}).get('runner_started_at'):
            return at(receipt['github']['runner_started_at'])
    except ValueError:
        return None
    span = job_span(receipt, now)
    if span:
        return span[0]
    return at(receipt['started_at']) if ran_job(receipt) else None


def busy_span(receipt, now):
    """A job's busy time. A runner receipt from before job end times were recorded ends when its VM did."""
    span = job_span(receipt, now)
    if span or not ran_job(receipt) or (start := job_start(receipt, now)) is None:
        return span
    return start, vm_span(receipt, now)[1]


def saturation(receipts, cutoff, now):
    def in_window(spans):
        return [(max(start, cutoff), end) for start, end in spans if end >= cutoff]

    ceilings = [r['vm']['host_ceiling'] for r in receipts if type((r.get('vm') or {}).get('host_ceiling')) is int]
    busy = filter(None, (busy_span(r, now) for r in receipts))
    return dict(vms_peak=most_at_once(in_window(vm_span(r, now) for r in receipts)),
                busy_peak=most_at_once(in_window(busy)), ceiling=max(ceilings, default=None),
                overflow_jobs=sum(1 for r in receipts if (job_start(r, now) or 0) >= cutoff
                                  and r.get('admission') and r['admission'].get('host') != r['admission'].get('primary')))


def orchestration_split(jobs):
    pairs = [(vm['ready_seconds'] + vm['destroy_seconds'], wall) for vm, wall in
             ((r.get('vm') or {}, job_wall(r)) for r in jobs)
             if all(type(value) in (int, float) for value in (vm.get('ready_seconds'), vm.get('destroy_seconds'), wall))]
    orchestration, test = sum(pair[0] for pair in pairs), sum(pair[1] for pair in pairs)
    return dict(jobs=len(pairs), missing=len(jobs) - len(pairs), orchestration_seconds=round(orchestration, 3),
                test_seconds=round(test, 3),
                orchestration_pct=round(100 * orchestration / (orchestration + test), 1) if orchestration + test else None)


def outcomes(settled):
    verdicts = collections.Counter(r.get('verdict') or 'unknown' for r in settled)
    definitive = verdicts['pass'] + verdicts['fail']
    return dict(settled=len(settled), definitive=definitive,
                definitive_pct=round(100 * definitive / len(settled), 1) if settled else None,
                verdicts=dict(sorted(verdicts.items())),
                incomplete_causes=dict(collections.Counter(r.get('cause') or 'unknown' for r in settled
                                                           if r.get('verdict') == 'incomplete').most_common()))


def read_receipts(folders, cutoff, now):
    found, unreadable = [], 0
    for folder in folders:
        for path in sorted(Path(folder).glob('cbx-*.json')):
            try:
                receipt = json.loads(path.read_text())
                if vm_span(receipt, now)[1] >= cutoff:
                    found.append(receipt)
            except (OSError, ValueError, KeyError, TypeError):
                unreadable += 1
    return found, unreadable


def stats_report(receipts, since, now):
    """Times cover jobs that started in the window, even on an older warm VM; saturation covers every VM alive in it."""
    cutoff = now - since
    active = receipts
    receipts = [r for r in receipts if at(r['started_at']) >= cutoff]
    jobs = [r for r in active if ran_job(r) and (job_start(r, now) or 0) >= cutoff]
    job_ids = set(map(id, jobs))
    group = collections.defaultdict(list)
    for r in jobs:
        group['repo', (r.get('github') or {}).get('repo') or r.get('repo') or 'unknown'].append(r)
    hosts = collections.defaultdict(list)
    for r in active:
        hosts[r.get('host') or 'unknown'].append(r)
    steps = collections.defaultdict(list)
    missing_steps = 0
    for r in jobs:
        times = step_times(r)
        missing_steps += not times
        for name, seconds in times:
            if type(seconds) in (int, float):
                steps[(r.get('github') or {}).get('repo') or r.get('repo') or 'unknown', name].append(seconds)
    settled_at = lambda r: at(r['started_at']) + r['seconds'] if 'seconds' in r else vm_span(r, now)[1]
    settled = [r for r in active if not running(r) and r.get('verdict') not in ('idle', 'refused')
               and settled_at(r) >= cutoff]
    job_end = lambda r: (job_span(r) or (0, at(r['job_ended_at']) if r.get('job_ended_at') else 0))[1]
    finished = sum(1 for r in active if ran_job(r) and not running(r) and job_end(r) >= cutoff)
    orphans = sum((r.get('vm') or {}).get('destroyed') is False and ('seconds' in r or past_ttl(r, now)) for r in active)
    slowest = sorted((dict(repo=repo, step=name, **spread(values)) for (repo, name), values in steps.items()),
                     key=lambda step: step['p90'], reverse=True)[:10]
    return dict(since_seconds=since, since=datetime.fromtimestamp(now - since, timezone.utc).isoformat(timespec='seconds'),
                vms=len(receipts), **job_stats(jobs), jobs_per_hour=round(finished * 3600 / since, 2),
                outcomes=outcomes(settled), split=orchestration_split(jobs), orphans=orphans,
                jobs_without_steps=missing_steps,
                repos={name: job_stats(rows) for (_, name), rows in sorted(group.items())},
                hosts={name: dict(job_stats([r for r in rows if id(r) in job_ids]),
                                  vms=sum(at(r['started_at']) >= cutoff for r in rows), **saturation(rows, cutoff, now))
                       for name, rows in sorted(hosts.items())},
                slowest_steps=slowest)


def stats_text(report):
    def cell(metric):
        if not metric['n']:
            return '-'
        return '/'.join(f'{metric[key]:.0f}' for key in ('p50', 'p90', 'max'))

    def missing(row):
        gaps = [f'{metric} {row[metric]["missing"]}' for metric in STAT_METRICS if row[metric]['missing']]
        return ', '.join(gaps) or '-'

    def table(rows):
        widths = [max(len(str(row[i])) for row in rows) for i in range(len(rows[0]))]
        return [' '.join(str(value).ljust(width) for value, width in zip(row, widths)).rstrip() for row in rows]

    def pct(value):
        return '-' if value is None else f'{value:g}%'

    def p50_p90(metric):
        return f"{metric['p50']:.0f}/{metric['p90']:.0f} s" if metric['n'] else '-'

    found, split = report['outcomes'], report['split']
    causes = ', '.join(f'{name} {count}' for name, count in found['incomplete_causes'].items()) or '-'
    lines = [f"coldbox stats: {report['jobs']} finished jobs on {report['vms']} VMs since {report['since']}",
             f"definitive (pass or fail): {found['definitive']} of {found['settled']} settled, {pct(found['definitive_pct'])}",
             f'incomplete causes: {causes}',
             f"ready p50/p90: {p50_p90(report['boot_to_ready'])}; queue p50/p90: {p50_p90(report['queue_wait'])}; "
             f"jobs/hour: {report['jobs_per_hour']:g}",
             f"orchestration (VM ready + destroy) vs test (job wall): {split['orchestration_seconds']:.0f} s vs "
             f"{split['test_seconds']:.0f} s, {pct(split['orchestration_pct'])} orchestration over {split['jobs']} jobs",
             f"orphans (vm.destroyed false after the job or its TTL): {report['orphans']}", '',
             'seconds as p50/p90/max; MISSING counts jobs whose receipt lacks the field', '']
    head = ['JOBS', 'QUEUE WAIT', 'BOOT TO READY', 'JOB WALL', 'MISSING']
    for title, key in (('REPO', 'repos'), ('HOST', 'hosts')):
        rows = [[title] + head] + [[name, row['jobs'], *(cell(row[m]) for m in STAT_METRICS), missing(row)]
                                   for name, row in report[key].items()]
        lines += table(rows) + ['']
    lines += table([['HOST', 'VMS PEAK', 'BUSY PEAK', 'CEILING', 'OVERFLOW JOBS']] +
                   [[name, row['vms_peak'], row['busy_peak'], row['ceiling'] or '-', row['overflow_jobs']]
                    for name, row in report['hosts'].items()]) + ['']
    lines += table([['SLOWEST STEPS', 'REPO', 'N', 'P50/P90/MAX']] +
                   [[step['step'], step['repo'], step['n'], cell(step)] for step in report['slowest_steps']])
    if report['jobs_without_steps']:
        lines.append(f"{report['jobs_without_steps']} job(s) recorded no step timing")
    return '\n'.join(lines)


def stats(args):
    now = time.time()
    receipts, unreadable = read_receipts(args.receipts or [STATE / 'receipts'], now - args.since, now)
    report = stats_report(receipts, args.since, now)
    report['unreadable_receipts'] = unreadable
    print(json.dumps(report, indent=2) if args.json else stats_text(report))
    if unreadable and not args.json:
        print(f'coldbox: skipped {unreadable} unreadable receipt(s)', file=sys.stderr)
    return 0


def detect_cmd(args):
    if args.workflow:
        return detect_workflow(args.path)
    found, host = detect(args.path), host_switches()
    if not found:
        print('coldbox: no checks detected; write [commands] in coldbox.toml yourself', file=sys.stderr)
        return 1
    print('# coldbox.toml: set a check to false to switch it off; replace a command under [commands].')
    print('[checks]')
    for name in [n for n in CHECK_ORDER if n in found] + [n for n in found if n not in CHECK_ORDER]:
        print(f"{name} = {'true' if host.get(name, True) else 'false'}  # " + ' ; '.join(found[name]))
    return 0


def detect_workflow(root):
    for path in sorted((Path(root) / '.github' / 'workflows').glob('*.y*ml')):
        lines = path.read_text(errors='replace').splitlines()
        if any(re.search(r'\bcoldbox\s+checks\b', line.split(' #')[0]) for line in lines
               if not re.match(r'\s*(#|-?\s*name:)', line)):
            print(f'coldbox: {path.relative_to(root)} already runs coldbox checks', file=sys.stderr)
            return 1
    steps = plan(root)
    if not steps:
        print('coldbox: no checks would run; write [commands] in coldbox.toml yourself', file=sys.stderr)
        return 1
    print(WORKFLOW + '# coldbox checks runs these here (coldbox.toml switches them):',
          *[f'#   {name}: ' + ' ; '.join(commands).replace('\n', '\n#     ') for name, commands in steps], sep='\n')
    return 0


def incus_group_exec(argv):
    if os.geteuid() == 0:
        return
    try:
        group = grp.getgrnam('incus-admin')
    except KeyError:
        return
    if group.gr_gid in (os.getegid(), *os.getgroups()) or pwd.getpwuid(os.getuid()).pw_name not in group.gr_mem:
        return
    os.execvp('sg', ['sg', 'incus-admin', '-c', shlex.join([sys.executable, str(Path(__file__).resolve()), *argv])])


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    words, command = argv, []
    if argv[:1] == ['run'] and '--' in argv:
        words, command = argv[:argv.index('--')], argv[argv.index('--') + 1:]
    parser = argparse.ArgumentParser(prog='coldbox', description=__doc__)
    parser.add_argument('--version', action='version', version=f'%(prog)s {VERSION} (build {build_id()})')
    sub = parser.add_subparsers(dest='cmd', required=True)
    p = sub.add_parser('detect', help='print a suggested coldbox.toml for a repo')
    p.add_argument('path', nargs='?', default='.')
    p.add_argument('--workflow', action='store_true',
                   help='print a GitHub Actions workflow that runs the checks, unless one already does')
    p = sub.add_parser('checks', help='run the enabled checks here (used inside the VM)')
    p.add_argument('path', nargs='?', default='.')
    p = sub.add_parser('run', help="run a local repo's or a GitHub commit's checks, or -- COMMAND, in a throwaway VM "
                                   'and write a receipt',
                       usage='coldbox run [-h] [--offline] [--ttl TTL] [--cpus N] [--memory SIZE] [--receipts DIR] '
                             '[path | --repo OWNER/REPO --sha SHA | -- COMMAND [ARG ...]]')
    p.add_argument('path', nargs='?')
    p.add_argument('--repo', type=repo_name, help='clone this GitHub repo in the VM, with a read-only token for it alone')
    p.add_argument('--sha', type=commit_sha, help='the full commit SHA to clone with --repo')
    p.add_argument('--offline', action='store_true', help='give the VM no network at all')
    p.add_argument('--ttl', type=int, default=3600, help='VM lifetime limit in seconds (default 3600)')
    p.add_argument('--cpus', type=vcpus, help="this VM's vCPU count instead of the coldbox profile's")
    p.add_argument('--memory', type=vm_size, help="this VM's memory, e.g. 8GiB, up to the coldbox profile's")
    p.add_argument('--receipts', metavar='DIR',
                   help=f"write the receipt to DIR instead of {STATE / 'receipts'}; for stress and test runs")
    for name, text in (('serve', 'run ephemeral runners for a repo or org in a loop'),
                       ('register', 'start a coldbox runner service for a repo or org')):
        p = sub.add_parser(name, help=text)
        p.add_argument('target', help='OWNER/REPO or ORG')
        p.add_argument('--allow-public', action='store_true',
                       default=name == 'serve' and os.environ.get('COLDBOX_ALLOW_PUBLIC') == '1',
                       help='serve a public repo you own: write users run at once, others after your approval')
        p.add_argument('--allow-forks', action='store_true', default=os.environ.get('COLDBOX_ALLOW_FORKS') == '1')
        p.add_argument('--slots', type=int, default=int(os.environ.get('COLDBOX_SLOTS', '1')),
                       help='job VMs that may run at once (default 1)')
        if name == 'serve':
            p.add_argument('--once', action='store_true', help='stop after one VM')
            p.add_argument('--ttl', type=int, default=21600, help='VM lifetime limit in seconds (default 21600)')
            p.add_argument('--worker', action='store_true', help=argparse.SUPPRESS)
            p.add_argument('--idle', type=int, default=0, help=argparse.SUPPRESS)
            p.add_argument('--name', help=argparse.SUPPRESS)
            p.add_argument('--size', choices=SIZES, default='default', help=argparse.SUPPRESS)
    p = sub.add_parser('unregister', help="stop the runner service and delete this host's coldbox runners on GitHub")
    p.add_argument('target')
    p = sub.add_parser('reap', help='delete job VMs past their TTL or without a live worker, finalize their receipts, and delete old receipts')
    p.add_argument('--keep-days', type=int, default=30, help='delete receipts older than this; 0 keeps all')
    vm = sub.add_parser('vm', help='a disposable VM to use by hand: up, exec, down, list').add_subparsers(
        dest='action', required=True)
    p = vm.add_parser('up', help='start a VM from base-dev/warm and print its name')
    p.add_argument('--ttl', type=int, default=7200, help='seconds before the reaper deletes it (default 7200)')
    p.add_argument('--offline', action='store_true', help='give the VM no network at all')
    p.add_argument('--here', action='store_true', help='start it on this host only, never on another CI host')
    p = vm.add_parser('exec', help='run a command in the VM as runner; stdin and stdout pass through')
    p.add_argument('name')
    p.add_argument('command', nargs='+')
    vm.add_parser('down', help='delete the VM').add_argument('name')
    vm.add_parser('list', help='list ad-hoc VMs')
    sub.add_parser('status', help='health checks, runners, job VMs and recent receipts')
    p = sub.add_parser('setup-app', help='set up least-privilege GitHub App auth: print the steps, then install its key (sudo)')
    p.add_argument('--org', help='create the App under this organization (for org-wide runners)')
    p.add_argument('--app-id', help='the numeric App ID shown after creating the App')
    p.add_argument('--key', help='the private key .pem downloaded from the App settings')
    p = sub.add_parser('stats', help='outcomes, queue wait, boot, job time, slowest steps and host load from recent receipts')
    p.add_argument('--since', type=window, default=window('1h'), help='how far back to look, e.g. 30m, 1h, 7d (default 1h)')
    p.add_argument('--receipts', metavar='DIR', action='append',
                   help=f"read receipts from DIR instead of {STATE / 'receipts'}; repeat to combine hosts")
    p.add_argument('--json', action='store_true', help='print the summary as JSON')
    p = sub.add_parser('selftest', help='prove in a job VM that isolation and the profile limits hold; writes a receipt')
    p.add_argument('suite', choices=['isolation'])
    p.add_argument('--ttl', type=int, default=3600, help='VM lifetime limit in seconds (default 3600)')
    p.add_argument('--receipts', metavar='DIR',
                   help=f"write the receipt to DIR instead of {STATE / 'receipts'}")
    p = sub.add_parser('build-base', help='rebuild base-dev/warm with current packages and actions-runner (sudo)')
    p.add_argument('--rollback', action='store_true', help='restore the previous base without rebuilding')
    sub.add_parser('acl', help='print the network ACL that install.sh applies')
    p = sub.add_parser('admission-check', help='validate this guest CI admission record')
    p.add_argument('--expected-primary', required=True)
    p.add_argument('--overflow-host', nargs='?', action='append', help=argparse.SUPPRESS)
    sub.add_parser('job-started', help="runner hook: refuse fork PRs or outside users' jobs, and record the job")
    p = sub.add_parser('junit', help='print per-test results from JUnit XML reports, and ColdVerify test counts, under DIRs as JSON')
    p.add_argument('--newer', help='only reports modified after this file; git-tracked reports are always skipped')
    p.add_argument('--archived', help='file listing paths copied in from git archive; those are skipped too')
    p.add_argument('dirs', nargs='+')
    args = parser.parse_args(words)
    if args.cmd == 'run':
        args.command = command
    if words is not argv and not command:
        parser.error('run --: give a command to run')
    if args.cmd in INCUS_COMMANDS:
        incus_group_exec(argv)
    try:
        if args.cmd == 'checks':
            out = os.environ.get('COLDBOX_JOB_DIR')
            return run_checks(args.path, out and Path(out) / 'checks.json')
        if args.cmd == 'acl':
            print(json.dumps(acl_document(host_addresses()), indent=2))
            return 0
        if args.cmd == 'admission-check':
            return admission_check(args)
        if args.cmd == 'job-started':
            code = 1
            try:
                code = job_started()
            finally:
                if code:
                    subprocess.run(['pkill', '-KILL', '-x', 'Runner.Worker'], check=False)
            return code
        if args.cmd == 'build-base':
            signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
        if args.cmd == 'junit':
            print(json.dumps(dict(junit_summary(args.dirs, args.newer, args.archived),
                                  cold_verify=cold_verify_counts(args.dirs, args.newer, args.archived))))
            return 0
        return dict(detect=detect_cmd, run=run_repo if args.cmd == 'run' and (args.repo or args.sha) else run_adhoc if command else run_local, serve=serve, register=register, unregister=unregister,
                    reap=reap, status=status, stats=stats, selftest=selftest, **{'setup-app': setup_app}, vm=vm_cmd, **{'build-base': build_base})[args.cmd](args)
    except ConfigError as error:
        print(f'coldbox: {error}', file=sys.stderr)
        return 2
    except (RuntimeError, subprocess.CalledProcessError) as error:
        print(f'coldbox: {error}', file=sys.stderr)
        return 125


if __name__ == '__main__':
    sys.exit(main())
