def swap_base():
    if not destroy('base-prev'):
        raise SystemExit('coldbox build-base: could not remove base-prev')
    try:
        ic('move', 'base-dev', 'base-prev')
    except subprocess.CalledProcessError:
        ic('move', 'base-new', 'base-dev')
        return
    try:
        ic('move', 'base-new', 'base-dev')
    except subprocess.CalledProcessError:
        ic('move', 'base-prev', 'base-dev')
        raise


def rollback_base():
    journal = STATE / 'base-rollback.json'

    def exists(name):
        try:
            ic('info', name)
        except subprocess.CalledProcessError as error:
            message = error.stderr.decode(errors='replace') if isinstance(error.stderr, bytes) else error.stderr or ''
            wrapped = rf'Error: Failed to fetch instance "{re.escape(name)}" in project "[^"]+": Instance not found'
            if re.fullmatch(r'(?:Error:\s*)?(?:The instance was|Instance) not found[.!]?', message.strip()) \
                    or re.fullmatch(wrapped, message.strip()):
                return False
            raise RuntimeError(f'coldbox build-base: cannot inspect {name}') from error
        return True

    if journal.exists():
        transaction = json.loads(journal.read_text())
    else:
        interrupted = exists('base-rollback')
        if not interrupted and not exists('base-prev'):
            raise SystemExit('coldbox build-base: no base-prev available for rollback')
        paths = [STATE / 'base-packages.txt', STATE / 'base-packages.prev.txt']
        transaction = dict(mode='swap', step=(2 if exists('base-dev') else 1) if interrupted else 0,
                           manifests=[path.read_bytes().hex() if path.exists() else None for path in paths])
        write_json(journal, transaction)
    phases = {'swap': range(4), 'restore': range(3), 'complete': (3,)}
    if transaction['mode'] not in phases or type(transaction['step']) is not int \
            or transaction['step'] not in phases[transaction['mode']] or len(transaction['manifests']) != 2:
        raise ValueError('invalid base rollback transaction')
    manifests = [bytes.fromhex(value) if value is not None else None for value in transaction['manifests']]
    if transaction['mode'] == 'complete':
        return

    def advance(step):
        transaction['step'] = step
        write_json(journal, transaction)

    def restore():
        if transaction['step'] == 2:
            if not exists('base-prev'):
                ic('move', 'base-dev', 'base-prev')
            advance(1)
        if transaction['step'] == 1:
            if exists('base-rollback'):
                ic('move', 'base-rollback', 'base-dev')
            advance(0)
        write_package_manifests(manifests)
        journal.unlink()

    if transaction['mode'] == 'restore':
        restore()
        return rollback_base()
    if transaction['step'] == 0:
        if not exists('base-rollback'):
            ic('move', 'base-dev', 'base-rollback')
        advance(1)
    try:
        if transaction['step'] == 1:
            if not exists('base-dev'):
                ic('move', 'base-prev', 'base-dev')
            advance(2)
        if transaction['step'] == 2:
            if exists('base-rollback'):
                ic('move', 'base-rollback', 'base-prev')
            advance(3)
    except subprocess.CalledProcessError:
        transaction['mode'] = 'restore'
        write_json(journal, transaction)
        restore()
        raise
    write_package_manifests(reversed(manifests))
    transaction['mode'] = 'complete'
    write_json(journal, transaction)


def write_package_manifests(contents):
    paths = [STATE / 'base-packages.txt', STATE / 'base-packages.prev.txt']
    for path, data in zip(paths, contents):
        if data is None:
            path.unlink(missing_ok=True)
        else:
            staged = path.with_suffix(path.suffix + '.tmp')
            staged.write_bytes(data)
            staged.replace(path)


def print_base_changes(old_runner, new_runner):
    def packages(path):
        return dict(line.split(maxsplit=1) for line in path.read_text().splitlines())
    current = packages(STATE / 'base-packages.txt')
    previous = STATE / 'base-packages.prev.txt'
    if not previous.exists():
        print(f'Packages: {len(current)}')
        return
    old = packages(previous)
    changed = [name for name in sorted(old.keys() | current.keys()) if old.get(name) != current.get(name)]
    for name in changed:
        print(f'{name}: {old.get(name, "(none)")} -> {current.get(name, "(none)")}')
    if not changed:
        print('Packages: no changes')
    print(f'actions-runner: {old_runner} -> {new_runner}')


def smoke_base():
    name = 'base-smoke'
    destroy(name)
    try:
        boot(name, int(time.time() + 900), False, base='base-new/warm')
        result = subprocess.run(ic_exec(name, 'true', cwd=f'/home/{RUNNER}', timeout=60), capture_output=True, text=True)
        if result.returncode:
            raise RuntimeError(f'`true` exited {result.returncode} in a VM cloned from base-new/warm: '
                               f'{result.stderr.strip()[-300:]}')
    finally:
        if not destroy(name):
            raise RuntimeError(f'could not delete the smoke VM {name}; incus delete --force {name}')


def build_base(args):
    if os.geteuid() != 0:
        raise SystemExit('coldbox build-base: run with sudo')
    with open(STATE / 'build-base.lock', 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not getattr(args, 'rollback', False) and (STATE / 'base-rollback.json').exists():
            rollback_base()
            (STATE / 'base-rollback.json').unlink()
        if getattr(args, 'rollback', False):
            rollback_base()
            print('coldbox build-base: PASS restored previous base as base-dev/warm')
            return 0
        try:
            old_runner = ic('config', 'get', 'base-dev', 'user.coldbox.runner') or '(none)'
        except subprocess.CalledProcessError:
            old_runner = '(none)'
        manifests = [STATE / 'base-packages.txt', STATE / 'base-packages.prev.txt']
        saved = [path.read_bytes() if path.exists() else None for path in manifests]
        try:
            version = build_new_base()
            try:
                smoke_base()
            except Exception as error:
                destroy('base-new')
                reason = ' '.join(f"{error} {getattr(error, 'stderr', None) or ''}".split())
                write_json(STATE / 'base-smoke-failed.json', dict(at=now_iso(), runner=version, reason=reason))
                raise SystemExit(f'coldbox build-base: FAIL the new base did not run a job, kept the current base: '
                                 f'{reason}') from error
            retire_live_base()
            swap_base()
        except BaseException:
            for path, data in zip(manifests, saved):
                if data is None:
                    path.unlink(missing_ok=True)
                else:
                    path.write_bytes(data)
            raise
        (STATE / 'base-smoke-failed.json').unlink(missing_ok=True)
        print_base_changes(old_runner.strip(), version)
        print(f'coldbox build-base: PASS base-dev/warm built with actions-runner {version}')
    return 0


GUEST_OVERLAY_DIRS = r'''set -eu
owned=$1/$2
mkdir -p "${owned%/*}"
touch "$owned"
while IFS= read -r line; do
  mode=${line%% *} dir=${line#* }
  path=$1/$dir
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    printf '%s\n' "$dir" >>"$owned"
  elif [ -d "$path" ] && [ ! -L "$path" ] && grep -qxF -- "$dir" "$owned"; then
    chmod "$mode" "$path"
  fi
done
'''


OVERLAY_DIRS_RECORD = 'var/lib/coldbox/overlay-dirs'


def guest_overlay_dirs():
    if os.path.lexists(GUEST_FILES / OVERLAY_DIRS_RECORD):
        raise ValueError(f'guest files may not contain {OVERLAY_DIRS_RECORD}; Coldbox keeps its own record there')
    found = []
    for top, names, _ in os.walk(GUEST_FILES):
        for directory in names:
            path = Path(top, directory)
            relative = str(path.relative_to(GUEST_FILES))
            if '\n' in relative:
                raise ValueError(f'guest file directory name contains a newline: {relative!r}')
            if not path.is_symlink():
                found.append(f'0{path.lstat().st_mode & 0o7777:04o} '.encode() + os.fsencode(relative) + b'\n')
    return b''.join(found)


def push_guest_files(name):
    if not GUEST_FILES.is_dir():
        return
    subprocess.run(ic_exec(name, 'sh', '-c', GUEST_OVERLAY_DIRS, 'sh', '/', OVERLAY_DIRS_RECORD, user=None), input=guest_overlay_dirs(),
                   check=True)
    pack = subprocess.Popen(['tar', '-C', str(GUEST_FILES), '--owner=0', '--group=0', '--numeric-owner', '-c', '.'],
                            stdout=subprocess.PIPE)
    try:
        subprocess.run(ic_exec(name, 'tar', '-C', '/', '-x', '--no-overwrite-dir', '--keep-directory-symlink',
                               user=None), stdin=pack.stdout, check=True)
    finally:
        pack.stdout.close()
        packed = pack.wait()
    if packed:
        raise subprocess.CalledProcessError(packed, pack.args)
    tool, link = 'opt/coldverify/coldverify', 'usr/local/bin/coldverify'
    if os.path.lexists(GUEST_FILES / tool) and not os.path.lexists(GUEST_FILES / link):
        subprocess.run(ic_exec(name, 'ln', '-sf', f'/{tool}', f'/{link}', user=None), check=True)


def seed_cloud_init_on_create_only(name):
    path = f'/1.0/instances/{name}/metadata?project={PROJECT}'
    metadata = query(path)
    for target, template in metadata['templates'].items():
        if target.startswith('/var/lib/cloud/seed/'):
            template['when'] = [when for when in template['when'] if when != 'copy']
    subprocess.run(['incus', '--force-local', 'query', '-X', 'PUT', '--data', json.dumps(metadata), path],
                   check=True, capture_output=True)


def build_new_base():
    version, url, digest = runner_release(fetch_json(RUNNER_RELEASES))
    new = 'base-new'
    destroy(new)
    try:
        ic('launch', IMAGE, new, '--vm', '--profile', 'coldbox', *lifecycle('never'))
        wait_ready(new, time.time() + 900, network=True)
        subprocess.run(ic_exec(new, 'env', f'RUNNER_URL={url}', f'RUNNER_SHA256={digest}', 'bash', '-s', user=None),
                       input=GUEST_SETUP.encode(), check=True)
        push_guest_files(new)
        packages = subprocess.run(ic_exec(new, 'dpkg-query', '-W', '-f', '${Package} ${Version}\\n', user=None),
                                  check=True, capture_output=True, text=True).stdout
        manifest = STATE / 'base-packages.txt'
        if manifest.exists():
            manifest.replace(STATE / 'base-packages.prev.txt')
        manifest.write_text(packages)
        ic('stop', new)
        seed_cloud_init_on_create_only(new)
        ic('config', 'set', new, f'user.coldbox.runner={version}')
        ic('snapshot', 'create', new, 'warm')
    except BaseException:
        destroy(new)
        raise
    return version


