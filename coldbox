def swap_base():
    destroy('base-old')
    try:
        ic('move', 'base-dev', 'base-old')
    except subprocess.CalledProcessError:
        ic('move', 'base-new', 'base-dev')
        return
    try:
        ic('move', 'base-new', 'base-dev')
    except subprocess.CalledProcessError:
        ic('move', 'base-old', 'base-dev')
        raise
    destroy('base-old')


def build_base(_args):
    if os.geteuid() != 0:
        raise SystemExit('coldbox build-base: run with sudo')
    with open(STATE / 'build-base.lock', 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        version = build_new_base()
        swap_base()
    print(f'coldbox build-base: PASS base-dev/warm built with actions-runner {version}')
    return 0


def build_new_base():
    version, url, digest = runner_release(fetch_json(RUNNER_RELEASES))
    new = 'base-new'
    destroy(new)
    try:
        ic('launch', IMAGE, new, '--vm', '--profile', 'coldbox')
        wait_ready(new, time.time() + 900, network=True)
        subprocess.run(ic_exec(new, 'env', f'RUNNER_URL={url}', f'RUNNER_SHA256={digest}', 'bash', '-s', user=None),
                       input=GUEST_SETUP.encode(), check=True)
        ic('stop', new)
        ic('config', 'set', new, f'user.coldbox.runner={version}')
        ic('snapshot', 'create', new, 'warm')
    except BaseException:
        destroy(new)
        raise
    return version


def status(_args):
    failures = []

    def check(ok, text, fix):
        print(f"{'PASS' if ok else 'FAIL'}  {text}")
        if not ok:
            print(f'      fix: {fix}')
            failures.append(text)

    check(Path('/dev/kvm').exists(), 'hardware virtualization (/dev/kvm)', 'enable VT-x/AMD-V in the BIOS')
    check(subprocess.run(['gh', 'auth', 'status'], capture_output=True).returncode == 0, 'gh is logged in',
          'gh auth login')
    for timer in ('coldbox-reap.timer', 'coldbox-refresh.timer'):
        active = subprocess.run(['systemctl', 'is-active', '--quiet', timer]).returncode == 0
        check(active, f'{timer} is active', 'sudo ./install.sh')
    registered = registrations()
    try:
        snapshot = query(f'/1.0/instances/base-dev/snapshots/warm?project={PROJECT}')
        runner = query(f'/1.0/instances/base-dev?project={PROJECT}')['config'].get('user.coldbox.runner', 'unknown')
        built = datetime.fromisoformat(snapshot['created_at'][:19]).replace(tzinfo=timezone.utc)
        age = (datetime.now(timezone.utc) - built).days
        check(age <= 14, f'base image built {age} day(s) ago, actions-runner {runner}', 'sudo coldbox build-base')
        space = query('/1.0/storage-pools/coldbox/resources')['space']
        check(space['used'] < 0.9 * space['total'],
              f"storage pool coldbox: {space['used'] / 2**30:.0f} of {space['total'] / 2**30:.0f} GiB used",
              'run coldbox reap, or reinstall with a larger COLDBOX_POOL_SIZE')
        memory, host = vm_memory(), host_memory()
        slots = sum(r['slots'] for r in registered if r['active'] == 'active')
        check(fits(slots, memory, host), f"job VMs: {ic('profile', 'get', 'coldbox', 'limits.cpu').strip()} vCPU, "
              f'{memory / 2**30:g} GiB each; {slots} slot(s) registered, {host / 2**30:.0f} GiB RAM',
              'unregister a repo or register again with fewer --slots')
        vms = [vm for vm in json.loads(ic('list', '--format', 'json')) if vm['name'].startswith('cbx-')]
    except (OSError, ValueError, subprocess.CalledProcessError):
        check(False, 'Coldbox is installed (base-dev/warm, storage pool, profile)', 'sudo ./install.sh')
        vms = []
    print('\nRunners')
    for r in registered:
        print(f"  {r['target']:32} {r['active']:10} {r['slots']} slot(s)")
    if not registered:
        print('  none: coldbox register OWNER/REPO')
    print('\nJob VMs')
    for vm in vms:
        left = int(vm['config'].get('user.coldbox.expires', 0)) - time.time()
        print(f"  {vm['name']:24} {vm['status']:10} expires in {max(0, left) / 60:.0f} min")
    if not vms:
        print('  none')
    print('\nRecent receipts')
    receipts = sorted((STATE / 'receipts').glob('cbx-*.json'), key=lambda path: path.stat().st_mtime)[-5:]
    for path in reversed(receipts):
        r = json.loads(path.read_text())
        print(f"  {r['id']:24} {r['verdict']:10} {r['repo'] or '':32} {r.get('seconds', 0):6.0f}s  {r['started_at']}")
    if not receipts:
        print('  none')
    return 1 if failures else 0


def detect_cmd(args):
    found = detect(args.path)
    if not found:
        print('coldbox: no checks detected; write [commands] in coldbox.toml yourself', file=sys.stderr)
        return 1
    print('# coldbox.toml: set a check to false to switch it off; replace a command under [commands].')
    print('[checks]')
    for name in [n for n in CHECK_ORDER if n in found] + [n for n in found if n not in CHECK_ORDER]:
        print(f'{name} = true  # ' + ' ; '.join(found[name]))
    return 0


def incus_group_exec(argv):
    if os.geteuid() == 0:
        return
    try:
        group = grp.getgrnam('incus-admin')
    except KeyError:
        return
    if group.gr_gid in (os.getegid(), *os.getgroups()) or pwd.getpwuid(os.getuid()).pw_name not in group.gr_mem:
        return
    os.execvp('sg', ['sg', 'incus-admin', '-c', shlex.join([sys.executable, str(Path(__file__).resolve()), *argv])])


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    parser = argparse.ArgumentParser(prog='coldbox', description=__doc__)
    sub = parser.add_subparsers(dest='cmd', required=True)
    p = sub.add_parser('detect', help='print a suggested coldbox.toml for a repo')
    p.add_argument('path', nargs='?', default='.')
    p = sub.add_parser('checks', help='run the enabled checks here (used inside the VM)')
    p.add_argument('path', nargs='?', default='.')
    p = sub.add_parser('run', help="run a local repo's checks in a throwaway VM and write a receipt")
    p.add_argument('path', nargs='?', default='.')
    p.add_argument('--offline', action='store_true', help='give the VM no network at all')
    p.add_argument('--ttl', type=int, default=3600, help='VM lifetime limit in seconds (default 3600)')
    for name, text in (('serve', 'run ephemeral runners for a repo or org in a loop'),
                       ('register', 'start a coldbox runner service for a repo or org')):
        p = sub.add_parser(name, help=text)
        p.add_argument('target', help='OWNER/REPO or ORG')
        p.add_argument('--allow-public', action='store_true', default=os.environ.get('COLDBOX_ALLOW_PUBLIC') == '1')
        p.add_argument('--allow-forks', action='store_true', default=os.environ.get('COLDBOX_ALLOW_FORKS') == '1')
        p.add_argument('--slots', type=int, default=int(os.environ.get('COLDBOX_SLOTS', '1')),
                       help='job VMs that may run at once (default 1)')
        if name == 'serve':
            p.add_argument('--once', action='store_true', help='stop after one VM')
            p.add_argument('--ttl', type=int, default=21600, help='VM lifetime limit in seconds (default 21600)')
    p = sub.add_parser('unregister', help='stop the runner service and delete coldbox runners on GitHub')
    p.add_argument('target')
    p = sub.add_parser('reap', help='delete job VMs past their TTL and old receipts')
    p.add_argument('--keep-days', type=int, default=30, help='delete receipts older than this; 0 keeps all')
    sub.add_parser('status', help='health checks, runners, job VMs and recent receipts')
    sub.add_parser('build-base', help='rebuild base-dev/warm with current packages and actions-runner (sudo)')
    sub.add_parser('acl', help='print the network ACL that install.sh applies')
    sub.add_parser('job-started', help='runner hook: refuse fork PRs and record the job')
    p = sub.add_parser('junit', help='print per-test results from JUnit XML reports under DIRs as JSON')
    p.add_argument('--newer', help='only reports modified after this file; git-tracked reports are always skipped')
    p.add_argument('--archived', help='file listing paths copied in from git archive; those are skipped too')
    p.add_argument('dirs', nargs='+')
    args = parser.parse_args(argv)
    if args.cmd in INCUS_COMMANDS:
        incus_group_exec(argv)
    try:
        if args.cmd == 'checks':
            out = os.environ.get('COLDBOX_JOB_DIR')
            return run_checks(args.path, out and Path(out) / 'checks.json')
        if args.cmd == 'acl':
            print(json.dumps(acl_document(host_addresses()), indent=2))
            return 0
        if args.cmd == 'job-started':
            return job_started()
        if args.cmd == 'junit':
            print(json.dumps(junit_summary(args.dirs, args.newer, args.archived)))
            return 0
        return dict(detect=detect_cmd, run=run_local, serve=serve, register=register, unregister=unregister,
                    reap=reap, status=status, **{'build-base': build_base})[args.cmd](args)
    except ConfigError as error:
        print(f'coldbox: {error}', file=sys.stderr)
        return 2
    except (RuntimeError, subprocess.CalledProcessError) as error:
        print(f'coldbox: {error}', file=sys.stderr)
        return 125


if __name__ == '__main__':
    sys.exit(main())
