def write_json(path, data):
    path = Path(path)
    tmp = path.with_suffix('.tmp')
    tmp.write_text(json.dumps(data, indent=2) + '\n')
    tmp.replace(path)


def size_bytes(text):
    match = re.fullmatch(r'\s*(\d+(?:\.\d+)?)\s*([KMGT]i?B|B)?\s*', text)
    if not match:
        raise ValueError(f'cannot read size {text!r}')
    return int(float(match[1]) * UNITS[match[2] or ''])


def host_memory(field='MemTotal'):
    for line in Path('/proc/meminfo').read_text().splitlines():
        if line.startswith(f'{field}:'):
            return int(line.split()[1]) * 1024
    raise RuntimeError(f'{field} missing from /proc/meminfo')


def fits(slots, vm_memory, host):
    return slots * vm_memory <= host - HOST_RESERVE


def runner_release(release):
    version = release['tag_name'].removeprefix('v')
    name = f'actions-runner-linux-x64-{version}.tar.gz'
    asset = next((a for a in release.get('assets', []) if a['name'] == name), None)
    if not asset:
        raise RuntimeError(f'actions/runner {version} has no {name}')
    digest = (asset.get('digest') or '').removeprefix('sha256:')
    if not digest:
        match = re.search(r'BEGIN SHA linux-x64 -->\s*([0-9a-f]{64})', release.get('body') or '')
        digest = match[1] if match else ''
    if not re.fullmatch(r'[0-9a-f]{64}', digest):
        raise RuntimeError(f'actions/runner {version}: no sha256 for {name}')
    return version, asset['browser_download_url'], digest


def detect(root):
    root = Path(root)

    def has(*names):
        return any((root / name).exists() for name in names)

    def files(pattern):
        return [p for p in root.rglob(pattern)
                if not any(part.startswith('.') or part in SKIP_DIRS for part in p.relative_to(root).parts)]

    found = {}

    def add(check, command):
        found.setdefault(check, []).append(command)

    if has('pyproject.toml', 'setup.py', 'setup.cfg', 'requirements.txt') or files('*.py'):
        if has('requirements.txt'):
            add('setup', 'pip3 install -r requirements.txt')
        add('lint', "python3 -m compileall -q -x '/[.]|node_modules' .")
        if files('test_*.py') or files('*_test.py'):
            add('test', 'python3 -m pytest -q')
    if has('package.json'):
        scripts = json.loads((root / 'package.json').read_text()).get('scripts', {})
        add('setup', 'npm ci' if has('package-lock.json') else 'npm install')
        if 'lint' in scripts:
            add('lint', 'npm run lint')
        if 'test' in scripts and 'no test specified' not in scripts['test']:
            add('test', 'npm test')
    if has('go.mod'):
        add('lint', 'test -z "$(gofmt -l .)" && go vet ./...')
        if files('*_test.go'):
            add('test', GO_TEST)
    if has('Cargo.toml'):
        add('lint', 'cargo fmt --check && cargo clippy --all-targets -- -D warnings')
        if any(RUST_TEST.search(p.read_text(errors='replace')) for p in files('*.rs')):
            add('test', CARGO_TEST)
    if files('*.sh'):
        add('lint', "find . -name '*.sh' -not -path '*/.*' -not -path '*/node_modules/*' -print0 | xargs -0 shellcheck")
    if has(RECIPE):
        add('verify', 'coldverify --ci')
    return found


def load_config(path, label='coldbox.toml'):
    if not path.exists():
        return {}, {}
    try:
        data = tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError as error:
        raise ConfigError(f'{label}: {error}')
    unknown = set(data) - {'checks', 'commands'}
    if unknown:
        raise ConfigError(f'{label}: unknown section {sorted(unknown)[0]!r}; use [checks] and [commands]')
    switches, commands = data.get('checks', {}), data.get('commands', {})
    for section, table, kind in (('checks', switches, bool), ('commands', commands, str)):
        if not isinstance(table, dict):
            raise ConfigError(f'{label}: [{section}] must be a table')
        for name, value in table.items():
            if not NAME.fullmatch(name):
                raise ConfigError(f'{label}: bad check name {name!r} in [{section}]')
            if type(value) is not kind or (kind is str and not value.strip()):
                raise ConfigError(f'{label}: [{section}] {name} must be {"true or false" if kind is bool else "a command string"}')
    return switches, commands


def host_switches():
    switches, commands = load_config(HOST_CHECKS, str(HOST_CHECKS))
    if commands:
        raise ConfigError(f'{HOST_CHECKS}: only [checks] belongs here; put [commands] in the repo coldbox.toml')
    return switches


def plan(root):
    host = host_switches()
    switches, overrides = load_config(Path(root) / 'coldbox.toml')
    found = detect(root)
    found.update({name: [command] for name, command in overrides.items()})
    missing = [name for name, on in switches.items() if on and name not in found]
    if missing:
        raise ConfigError(f'coldbox.toml: check {missing[0]!r} is on but nothing was detected; add it under [commands]')
    names = [n for n in CHECK_ORDER if n in found] + [n for n in found if n not in CHECK_ORDER]
    return [(name, found[name]) for name in names if switches.get(name, host.get(name, True))]


def run_checks(root, out=None):
    steps = plan(root)
    results, setup_failed = [], False
    junit_dir = out and Path(out).parent / 'junit' / str(os.getpid())
    for name, commands in steps:
        for command in commands:
            if setup_failed:
                results.append(dict(check=name, command=command, status='skipped', exit=None, seconds=0))
                continue
            print(f'== coldbox {name}: {command}', flush=True)
            started = time.monotonic()
            env = dict(os.environ)
            if out and not sets_junitxml(root, command):
                junit = f"--junitxml={junit_dir / f'{len(results)}.xml'}"
                env['PYTEST_ADDOPTS'] = ' '.join(filter(None, [os.environ.get('PYTEST_ADDOPTS'), junit]))
            code = subprocess.run(['bash', '-eo', 'pipefail', '-c', command], cwd=root, env=env).returncode
            results.append(dict(check=name, command=command, status='pass' if code == 0 else 'fail',
                                exit=code, seconds=round(time.monotonic() - started, 3)))
            setup_failed = name == 'setup' and code != 0
    verdict = 'pass' if results and all(r['status'] == 'pass' for r in results) else 'fail'
    summary = dict(verdict=verdict, checks=results)
    if not results:
        summary['error'] = 'no checks to run'
    if out:
        write_json(out, summary)
    for r in results:
        print(f"{r['status'].upper():8} {r['check']:8} {r['seconds']:8.1f}s  {r['command']}")
    print(f'coldbox checks: {verdict.upper()}' + (' (nothing to run)' if not results else ''))
    if os.environ.get('GITHUB_ACTIONS') == 'true':
        annotate(results, junit_dir)
    return 0 if verdict == 'pass' else 1


def annotate(results, junit_dir):
    def error(title, message):
        message = message.replace('%', '%25').replace('\r', '%0D').replace('\n', '%0A')
        print(f'::error title={title}::{message}', flush=True)

    tests = junit_summary([junit_dir]) if junit_dir else dict(failed=0, error=0, results=[])
    count = tests['failed'] + tests['error']
    names = ['.'.join(filter(None, (t['classname'], t['name'])))
             for t in tests['results'] if t['status'] in ('failed', 'error')][:10]
    if count:
        error(f'coldbox {count} test(s) failed', ', '.join(names + ['...'] * (count > len(names))))
    for r in results:
        if r['status'] == 'fail':
            error(f"coldbox {r['check']} failed", f"{r['command']} exited {r['exit']}")
    if not results:
        error('coldbox found nothing to run', 'switch a check on or add one under [commands] in coldbox.toml')


def sets_junitxml(root, command):
    configs = [Path(root) / name for name in PYTEST_CONFIGS]
    texts = [command, os.environ.get('PYTEST_ADDOPTS', '')]
    texts += [path.read_text(errors='replace') for path in configs if path.is_file()]
    return any('junitxml' in text for text in texts)


def tracked(path):
    return subprocess.run(['git', '-C', str(path.parent), 'ls-files', '--error-unmatch', '--', path.name],
                          capture_output=True).returncode == 0


def junit_files(dirs, since=0, archived=frozenset()):
    for top in dirs:
        for root, subdirs, names in os.walk(top):
            subdirs[:] = sorted(d for d in subdirs if not d.startswith('.') and d not in ('node_modules', 'vendor'))
            for name in sorted(names):
                path = Path(root) / name
                try:
                    if not name.endswith('.xml') or path.stat().st_mtime < since:
                        continue
                    with path.open('rb') as report:
                        if b'<testsuite' in report.read(4096) and str(path) not in archived and not tracked(path):
                            yield path
                except OSError:
                    pass


def junit_seconds(text):
    try:
        return round(float(text), 3)
    except (TypeError, ValueError):
        return None


def junit_summary(dirs, newer=None, archived=None):
    files, results = [], []
    skip = frozenset(Path(archived).read_text().splitlines()) if archived else frozenset()
    for path in junit_files(dirs, os.stat(newer).st_mtime if newer else 0, skip):
        try:
            report = ET.parse(path).getroot()
        except (ET.ParseError, OSError):
            continue
        files.append(str(path))
        for suite in report.iter('testsuite'):
            for case in suite.findall('testcase'):
                status = next((s for tag, s in JUNIT_STATUS if case.find(tag) is not None), 'passed')
                results.append(dict(suite=suite.get('name', ''), classname=case.get('classname', ''),
                                    name=case.get('name', ''), status=status, seconds=junit_seconds(case.get('time'))))
    counts = {status: sum(r['status'] == status for r in results) for status in ('passed', 'failed', 'error', 'skipped')}
    return dict(files=files, total=len(results), **counts, truncated=len(results) > MAX_TEST_RESULTS,
                results=results[:MAX_TEST_RESULTS])


def job_started(env=None):
    env = os.environ if env is None else env
    event = {}
    if env.get('GITHUB_EVENT_PATH'):
        event = json.loads(Path(env['GITHUB_EVENT_PATH']).read_text())
    name = env.get('GITHUB_EVENT_NAME') or ''
    fork = None if name not in SAME_REPO_EVENTS else False
    pr = event.get('pull_request')
    if pr:
        repos = (pr.get('head') or {}).get('repo'), (pr.get('base') or {}).get('repo')
    elif name == 'workflow_run':
        repos = (event.get('workflow_run') or {}).get('head_repository'), event.get('repository')
    if pr or name == 'workflow_run':
        head, base = ((repo or {}).get('full_name') for repo in repos)
        fork = head is None or head != base
    refused = None
    if fork is not False and env.get('COLDBOX_ALLOW_FORKS') != '1':
        refused = 'fork pull request' if fork else f'{name or "unknown"} event: cannot tell whether the code is from a fork'
    job = dict(repo=env.get('GITHUB_REPOSITORY'), sha=env.get('GITHUB_SHA'), ref=env.get('GITHUB_REF'),
               event=name, workflow=env.get('GITHUB_WORKFLOW'), job=env.get('GITHUB_JOB'),
               run_id=env.get('GITHUB_RUN_ID'), run_attempt=env.get('GITHUB_RUN_ATTEMPT'),
               actor=env.get('GITHUB_ACTOR'), fork_pr=fork, refused=refused)
    if env.get('COLDBOX_JOB_DIR'):
        write_json(Path(env['COLDBOX_JOB_DIR']) / 'job.json', job)
    if refused:
        print(f'coldbox: refusing this job ({refused}); register with --allow-forks to run it', file=sys.stderr)
        return 1
    return 0


def acl_document(addresses):
    blocked = ['0.0.0.0/8', '10.0.0.0/8', '100.64.0.0/10', '127.0.0.0/8', '169.254.0.0/16', '172.16.0.0/12',
               '192.0.0.0/24', '192.0.2.0/24', '192.168.0.0/16', '198.18.0.0/15', '198.51.100.0/24',
               '203.0.113.0/24', '224.0.0.0/4', '240.0.0.0/4']
    public = [ipaddress.ip_network('0.0.0.0/0')]
    for cidr in blocked:
        net = ipaddress.ip_network(cidr)
        public = [part for old in public for part in (old.address_exclude(net) if net.subnet_of(old) else [old])]
    egress = [dict(action='allow', state='enabled', destination=str(net)) for net in public]
    for protocol, ports in (('udp', '53,67'), ('tcp', '53')):
        egress.append(dict(action='allow', state='enabled', destination=GATEWAY, protocol=protocol,
                           destination_port=ports))
    egress.append(dict(action='allow', state='enabled', destination='255.255.255.255', protocol='udp',
                       destination_port='67'))
    for interface in addresses:
        for addr in interface.get('addr_info', []):
            if addr['family'] == 'inet' and ipaddress.ip_address(addr['local']).is_global:
                egress.insert(0, dict(action='reject', state='enabled', destination=addr['local']))
    ingress = [dict(action='allow', state='enabled', source=GATEWAY, protocol='udp', source_port='67',
                    destination_port='68')]
    return dict(description='Coldbox: public internet only; no LAN, tailnet or host',
                config={'user.coldbox.managed': 'true'},
                ingress=ingress, egress=egress)


def host_addresses():
    return json.loads(subprocess.run(['ip', '-j', 'address', 'show'], check=True, capture_output=True,
                                     text=True).stdout)


def sync_acl():
    subprocess.run(['incus', '--force-local', 'network', 'acl', 'edit', NETWORK_ACL],
                   input=json.dumps(acl_document(host_addresses())), check=True, capture_output=True, text=True)


def query(path):
    return json.loads(subprocess.run(['incus', '--force-local', 'query', path], check=True, capture_output=True,
                                     text=True).stdout)


def ic(*args, **kwargs):
    return subprocess.run(['incus', '--force-local', '--project', PROJECT, *args], check=True, text=True,
                          stdin=subprocess.DEVNULL, capture_output=True, **kwargs).stdout


def ic_exec(name, *command, user=RUNNER, cwd=None, env=(), timeout=None):
    prefix = ['timeout', '--signal=KILL', str(max(1, int(timeout)))] if timeout else []
    args = ['incus', '--force-local', '--project', PROJECT, 'exec', name, '--mode', 'non-interactive']
    if user:
        args += ['--env', f'HOME=/home/{user}']
        command = ('runuser', '-u', user, '--', *command)
    if cwd:
        args += ['--cwd', cwd]
    for item in env:
        args += ['--env', item]
    return prefix + args + ['--', *command]


def tee(command, log, data=None):
    proc = subprocess.Popen(command, stdin=subprocess.PIPE if data is not None else subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if data is not None:
        proc.stdin.write(data)
        proc.stdin.close()
    for line in proc.stdout:
        log.write(line)
        log.flush()
        sys.stdout.buffer.write(line)
        sys.stdout.flush()
    return proc.wait()


def isolated(name, offline):
    vm = query(f'/1.0/instances/{name}?project={PROJECT}')
    devices, config = vm.get('expanded_devices', {}), vm.get('expanded_config', {})
    root, nic = devices.get('root', {}), devices.get('eth0', {})
    problems = []
    if vm.get('type') != 'virtual-machine':
        problems.append('not a VM')
    if set(devices) != {'root', 'eth0'}:
        problems.append(f'unexpected devices {sorted(devices)}')
    if root.get('type') != 'disk' or root.get('path') != '/' or root.get('source'):
        problems.append('root disk is not a plain pool volume')
    if offline and nic.get('type') != 'none':
        problems.append('offline VM still has a NIC')
    if not offline and (nic.get('type') != 'nic' or nic.get('network') != BRIDGE
                        or nic.get('security.port_isolation') != 'true'):
        problems.append(f'NIC is not on the isolated {BRIDGE} bridge')
    if any(key.startswith('raw.') for key in config):
        problems.append('raw.* config present')
    if problems:
        raise RuntimeError('Refusing unsafe VM: ' + '; '.join(problems))


BOOT_SECONDS = 300
STOPPED_SECONDS = 30


def wait_ready(name, expires, network, restarts=3):
    boot_deadline = time.time() + BOOT_SECONDS
    stopped_since = None
    while subprocess.run(ic_exec(name, 'true', user=None, timeout=10), capture_output=True).returncode:
        if time.time() > expires:
            raise RuntimeError('VM agent not ready before TTL')
        if query(f'/1.0/instances/{name}?project={PROJECT}')['status'] != 'Stopped':
            stopped_since = None
        elif stopped_since is None:
            stopped_since = time.time()
        if (stopped_since is not None and time.time() - stopped_since > STOPPED_SECONDS) or time.time() > boot_deadline:
            stopped_since = None
            if not restarts:
                raise RuntimeError('VM agent not ready after restarts')
            restarts -= 1
            subprocess.run(['incus', '--force-local', '--project', PROJECT, 'stop', name, '--force'],
                           capture_output=True)
            subprocess.run(['incus', '--force-local', '--project', PROJECT, 'start', name], capture_output=True)
            boot_deadline = time.time() + BOOT_SECONDS
        time.sleep(1)
    if network:
        code = subprocess.run(ic_exec(name, 'cloud-init', 'status', '--wait', user=None,
                                      timeout=expires - time.time()), capture_output=True).returncode
        if code not in (0, 2):
            raise RuntimeError(f'cloud-init failed in VM (exit {code})')


def pull(name, path):
    result = subprocess.run(['incus', '--force-local', '--project', PROJECT, 'file', 'pull', f'{name}{path}', '-'],
                            capture_output=True, text=True)
    return json.loads(result.stdout) if result.returncode == 0 and result.stdout.strip() else None


def destroy(name, attempts=3):
    for attempt in range(attempts):
        if attempt:
            time.sleep(5)
        subprocess.run(['incus', '--force-local', '--project', PROJECT, 'delete', name, '--force'], capture_output=True)
        info = subprocess.run(['incus', '--force-local', '--project', PROJECT, 'info', name], capture_output=True)
        if info.returncode != 0 and b'Instance not found' in info.stderr:
            return True
    return False


def boot(name, expires, offline, *config):
    sync_acl()
    ic('copy', BASE, name, '--config', f'user.coldbox.expires={expires}', *config)
    if offline:
        ic('config', 'device', 'add', name, 'eth0', 'none')
    isolated(name, offline)
    ic('start', name)
    wait_ready(name, expires, network=not offline)


def job(mode, name, ttl, command, repo, sha=None, stdin=None, archive=None, offline=False, cwd=None, env=(),
        extra=None, receipts=None):
    CLEANUP.clear()
    receipts = Path(receipts or STATE / 'receipts')
    receipts.mkdir(parents=True, exist_ok=True)
    path, log_path = receipts / f'{name}.json', receipts / f'{name}.log'
    started = time.time()
    expires = int(started + ttl)
    receipt = dict(schema='coldbox.receipt/v1', id=name, mode=mode, repo=repo, sha=sha, verdict='incomplete',
                   host=os.uname().nodename, checks=[], started_at=now_iso(), log=str(log_path), **(extra or {}),
                   vm=dict(name=name, image=BASE, ttl_seconds=ttl, offline=offline, destroyed=False))
    write_json(path, receipt)
    guest_env = [f'COLDBOX_JOB_DIR={GUEST_JOB_DIR}', 'PIP_BREAK_SYSTEM_PACKAGES=1', *env]
    with log_path.open('ab') as log:
        try:
            boot(name, expires, offline)
            receipt['vm']['ready_seconds'] = round(time.time() - started, 3)
            ic('file', 'push', str(Path(__file__).resolve()), f'{name}/usr/local/bin/coldbox', '--mode', '0755')
            if HOST_CHECKS.exists():
                ic('file', 'push', str(HOST_CHECKS), f'{name}{HOST_CHECKS}', '--create-dirs', '--mode', '0644')
            if archive is not None:
                extract = f'mkdir -p ~/repo && tar -x -v -C ~/repo | sed "s|^|$HOME/repo/|" > {ARCHIVED}'
                subprocess.run(ic_exec(name, 'bash', '-o', 'pipefail', '-c', extract), input=archive,
                               check=True, capture_output=True)
            subprocess.run(ic_exec(name, 'touch', JOB_STARTED), check=True, capture_output=True)
            command_started = time.time()
            code = tee(ic_exec(name, *command, cwd=cwd, env=guest_env, timeout=expires - time.time()), log, stdin)
            receipt['job_seconds'] = round(time.time() - command_started, 3)
            receipt['exit'] = code
            if mode == 'runner':
                receipt['job_name'], receipt['job_result'] = job_outcome(log_path.read_bytes())
            if code in (124, 137) and time.time() >= expires - 1:
                receipt['error'] = 'TTL reached'
            github, result = pull(name, f'{GUEST_JOB_DIR}/job.json'), pull(name, f'{GUEST_JOB_DIR}/checks.json')
            if github:
                receipt.update(github=github, repo=github['repo'] or repo, sha=github['sha'])
            if result:
                receipt.update(checks=result['checks'], checks_verdict=result['verdict'])
            tests = subprocess.run(ic_exec(name, 'coldbox', 'junit', '--newer', JOB_STARTED,
                                           *(['--archived', ARCHIVED] if archive is not None else []),
                                           *JUNIT_DIRS[mode], timeout=120),
                                   capture_output=True, text=True)
            if tests.returncode == 0 and json.loads(tests.stdout)['total']:
                receipt['tests'] = json.loads(tests.stdout)
        except subprocess.CalledProcessError as error:
            stderr = error.stderr.decode() if isinstance(error.stderr, bytes) else error.stderr or ''
            receipt['error'] = f"{' '.join(map(str, error.cmd[:7]))} failed: {stderr.strip()[-500:]}"
        except (OSError, RuntimeError, ValueError) as error:
            receipt['error'] = str(error)
        except (SystemExit, KeyboardInterrupt):
            receipt['error'] = 'stopped'
            if mode == 'runner' and (assigned := running_job(log_path.read_bytes())):
                receipt['job_name'] = assigned
            raise
        finally:
            CLEANUP.set()
            gone = destroy(name)
            ended = time.time()
            receipt['vm'].update(destroyed=gone, destroyed_at=now_iso(), lifetime_seconds=round(ended - started, 3))
            receipt['seconds'] = round(ended - started, 3)
            receipt['verdict'] = verdict(receipt)
            write_json(path, receipt)
    print(f"coldbox: {receipt['verdict'].upper()} receipt {path}", file=sys.stderr)
    return receipt


def job_outcome(log):
    found = re.findall(rb'Job (.+) completed with result: (\w+)', log)
    return tuple(part.decode(errors='replace') for part in found[-1]) if found else (None, None)


def running_job(log):
    found = re.findall(rb'Running job: (.+)', log)
    return found[-1].decode(errors='replace').strip() if found else None


def verdict(receipt):
    if not receipt['vm']['destroyed']:
        return 'incomplete'
    if (receipt.get('github') or {}).get('refused'):
        return 'refused'
    if receipt.get('checks_verdict') == 'fail' or receipt.get('job_result') == 'Failed':
        return 'fail'
    if receipt.get('error'):
        idle = (receipt['mode'] == 'runner' and 'github' not in receipt and not receipt.get('job_name')
                and receipt['error'] in ('TTL reached', IDLE_RELEASED, 'stopped'))
        return 'idle' if idle else 'incomplete'
    if receipt['mode'] == 'runner' and receipt.get('github'):
        if receipt.get('job_result') == 'Succeeded':
            return 'pass'
        if receipt.get('job_result') == 'Canceled':
            return 'canceled'
    if receipt['mode'] == 'local' and receipt.get('checks_verdict') == 'pass' and receipt.get('exit') == 0:
        return 'pass'
    if receipt['mode'] == 'adhoc' and 'exit' in receipt:
        return 'pass' if receipt['exit'] == 0 else 'fail'
    return 'incomplete'


def git(path, *args):
    return subprocess.run(['git', '-C', str(path), *args], check=True, capture_output=True).stdout


def run_local(args):
    path = Path(args.path).resolve()
    sha = git(path, 'rev-parse', 'HEAD').decode().strip()
    remote = subprocess.run(['git', '-C', str(path), 'remote', 'get-url', 'origin'], capture_output=True, text=True)
    match = re.search(r'[:/]([^/:]+/[^/]+?)(\.git)?$', remote.stdout.strip())
    if git(path, 'status', '--porcelain', '--', 'coldbox.toml').strip():
        raise SystemExit('coldbox: commit coldbox.toml first; the VM runs the committed HEAD')
    plan(path)
    name = new_id()
    if not admit(match[1] if match else path.name, name, 'once'):
        raise SystemExit('coldbox: the host is at its job VM ceiling; try again when a job finishes')
    receipt = job('local', name, args.ttl, ['coldbox', 'checks'], repo=match[1] if match else path.name,
                  sha=sha, archive=git(path, 'archive', '--format=tar', 'HEAD'), offline=args.offline,
                  cwd='/home/runner/repo', receipts=args.receipts)
    return exit_code(receipt)


def run_adhoc(args):
    if args.path != '.':
        raise SystemExit('coldbox: give a repo PATH or -- COMMAND, not both')
    name = new_id()
    if not admit('adhoc', name, 'once'):
        raise SystemExit('coldbox: the host is at its job VM ceiling; try again when a job finishes')
    receipt = job('adhoc', name, args.ttl, args.command, repo='adhoc', offline=args.offline, cwd=f'/home/{RUNNER}',
                  extra=dict(command=args.command), receipts=args.receipts)
    return 125 if 'error' in receipt or 'exit' not in receipt or not receipt['vm']['destroyed'] else receipt['exit']


def adhoc_vms():
    return {vm['name']: vm for vm in json.loads(ic('list', '--format', 'json'))
            if vm['name'].startswith('cbx-') and (vm.get('config') or {}).get(ADHOC) == 'true'}


def vm_cmd(args):
    if args.action == 'up':
        name = new_id()
        if not admit('vm', name, 'vm'):
            raise SystemExit('coldbox: the host is at its job VM ceiling; try again when a job finishes')
        try:
            boot(name, int(time.time() + args.ttl), args.offline, '--config', f'{ADHOC}=true')
        except BaseException:
            destroy(name)
            raise
        print(name)
        return 0
    vms = adhoc_vms()
    if args.action == 'list':
        for vm in vms.values():
            left = int(vm['config'].get('user.coldbox.expires', 0)) - time.time()
            print(f"{vm['name']}\t{vm['status']}\texpires in {max(0, left) / 60:.0f} min")
        return 0
    if args.name not in vms:
        raise SystemExit(f'coldbox: no ad-hoc VM named {args.name}; see coldbox vm list')
    if args.action == 'down':
        gone = destroy(args.name)
        print(f"coldbox: {args.name} {'deleted' if gone else 'FAILED to delete'}", file=sys.stderr)
        return 0 if gone else 1
    left = int(vms[args.name]['config']['user.coldbox.expires']) - time.time()
    if left <= 0:
        raise SystemExit(f'coldbox: {args.name} has expired; the reaper will delete it')
    return subprocess.run(ic_exec(args.name, *args.command, cwd=f'/home/{RUNNER}', timeout=left)).returncode


def gh(*args, body=None):
    command = ['gh', 'api', *args] + (['--input', '-'] if body is not None else [])
    result = subprocess.run(command, input=json.dumps(body) if body is not None else None, capture_output=True,
                            text=True)
    if result.returncode:
        raise RuntimeError(f'gh api {" ".join(args)}: {result.stderr.strip() or result.stdout.strip()}')
    return json.loads(result.stdout) if result.stdout.strip() else None


def scope(target):
    if not TARGET.fullmatch(target):
        raise SystemExit(f'coldbox: {target!r} is not OWNER/REPO or ORG')
    return f'repos/{target}' if '/' in target else f'orgs/{target}'


def guard(target, allow_public):
    if '/' in target:
        repo = gh(scope(target))
        if str(repo.get('full_name')).casefold() != target.casefold():
            raise SystemExit(f"coldbox: refusing: {target} now resolves to {repo.get('full_name')}")
        public = repo['visibility'] != 'private'
        what = f'{target} is not a private repository'
    else:
        public = gh(f'orgs/{target}/actions/runner-groups/1')['allows_public_repositories']
        what = f"org {target}'s default runner group allows public repositories"
    if public and not allow_public:
        raise SystemExit(f'coldbox: refusing: {what}. Fork pull requests on public repositories can run code on '
                         'this machine. Pass --allow-public only if you accept that.')


def stop_once(*_):
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    sys.exit(143)


def exit_code(receipt):
    return {'pass': 0, 'fail': 1}.get(receipt['verdict'], 125)


def worker_argv(args, *extra):
    argv = [sys.executable, str(Path(__file__).resolve()), 'serve', args.target, '--worker', '--ttl', str(args.ttl)]
    return argv + ['--allow-public'] * args.allow_public + ['--allow-forks'] * args.allow_forks + list(extra)


def serve_slots(args):
    children = [subprocess.Popen(worker_argv(args, *['--once'] * args.once)) for _ in range(args.slots)]
    bursts = []
    STOPPING.clear()
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, lambda *_: [STOPPING.set()] + [child.send_signal(signal.SIGTERM)
                                                               for child in children + bursts if child.poll() is None])
    if args.once:
        return max(child.wait() for child in children)
    github = GitHub() if '/' in args.target else None
    next_pass = 0
    while not STOPPING.is_set() and all(child.poll() is None for child in children):
        if github and time.time() >= next_pass:
            next_pass = time.time() + AUTOSCALE_SECONDS
            try:
                autoscale(github, args, bursts)
            except (OSError, RuntimeError, ValueError, KeyError, subprocess.SubprocessError) as error:
                print(f'coldbox: autoscale pass failed: {type(error).__name__}: {error}', file=sys.stderr, flush=True)
        time.sleep(1)
    for child in children + bursts:
        if child.poll() is None:
            child.send_signal(signal.SIGTERM)
    return max((child.wait() for child in children + bursts), default=143) or 1


def release_idle(target, runner_id):
    if CLEANUP.is_set():
        return
    try:
        gh('-X', 'DELETE', f'{scope(target)}/actions/runners/{runner_id}')
    except RuntimeError as error:
        if 'HTTP 422' not in str(error):
            retry = threading.Timer(60, release_idle, (target, runner_id))
            retry.daemon = True
            retry.start()
        return
    os.kill(os.getpid(), signal.SIGUSR1)


def idle_released(*_):
    if not CLEANUP.is_set():
        raise RuntimeError(IDLE_RELEASED)


def serve(args):
    if not args.worker and (args.slots > 1 or not args.once):
        return serve_slots(args)
    signal.signal(signal.SIGTERM, stop_once)
    signal.signal(signal.SIGUSR1, idle_released)
    env = ['ACTIONS_RUNNER_HOOK_JOB_STARTED=/opt/coldbox-job-started.sh']
    if args.allow_forks:
        env.append('COLDBOX_ALLOW_FORKS=1')
    while True:
        guard(args.target, args.allow_public)
        name = args.name or new_id()
        if args.idle:
            note_worker(os.getpid(), args.target, name, 'burst')
        elif not admit(args.target, name, 'base' if args.worker and not args.once else 'once'):
            if args.once:
                raise SystemExit('coldbox: the host is at its job VM ceiling; not starting another')
            print('coldbox: the host is at its job VM ceiling; waiting', file=sys.stderr, flush=True)
            time.sleep(30)
            continue
        runner = gh('-X', 'POST', f'{scope(args.target)}/actions/runners/generate-jitconfig',
                    body=dict(name=name, runner_group_id=1, labels=LABELS, work_folder='_work'))
        idle = threading.Timer(args.idle, release_idle, (args.target, runner['runner']['id'])) if args.idle else None
        try:
            if idle:
                idle.daemon = True
                idle.start()
            print(f'coldbox: runner {name} waiting for a job on {args.target}', file=sys.stderr, flush=True)
            receipt = job('runner', name, args.ttl, ['sh', '-c', 'read -r c; exec ./run.sh --jitconfig "$c"'],
                          repo=args.target, stdin=(runner['encoded_jit_config'] + '\n').encode(),
                          cwd='/opt/actions-runner', env=env, extra=dict(runner_id=runner['runner']['id']))
        finally:
            if idle:
                idle.cancel()
            try:
                gh('-X', 'DELETE', f"{scope(args.target)}/actions/runners/{runner['runner']['id']}")
            except RuntimeError:
                pass
        if args.once:
            return exit_code(receipt)
        if 'job_seconds' not in receipt:
            time.sleep(30)


class GitHub:
    def __init__(self):
        self.cache, self.used = {}, set()
        self.remaining, self.reset = None, 0

    def get(self, path):
        if self.remaining is not None and self.remaining < QUOTA_RESERVE and time.time() < self.reset:
            raise RuntimeError(f'GitHub API quota low ({self.remaining} left); waiting for its reset')
        token = subprocess.run(['gh', 'auth', 'token'], capture_output=True, text=True, check=True,
                               timeout=60).stdout.strip()
        headers = {'Authorization': f'Bearer {token}', 'Accept': 'application/vnd.github+json',
                   'X-GitHub-Api-Version': '2022-11-28', 'User-Agent': 'coldbox'}
        self.used.add(path)
        if path in self.cache:
            headers['If-None-Match'] = self.cache[path][0]
        request = urllib.request.Request(f'https://api.github.com/{path}', headers=headers)
        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                self.note(response.headers)
                value = json.loads(response.read())
                if response.headers.get('ETag'):
                    self.cache[path] = (response.headers['ETag'], value)
                return value
        except urllib.error.HTTPError as error:
            self.note(error.headers)
            if error.code == 304 and path in self.cache:
                return self.cache[path][1]
            raise RuntimeError(f'GET {path}: HTTP {error.code}') from None

    def note(self, headers):
        if headers and headers.get('X-RateLimit-Remaining') is not None:
            self.remaining = int(headers['X-RateLimit-Remaining'])
            self.reset = int(headers.get('X-RateLimit-Reset', 0))

    def forget_unused(self):
        self.cache = {path: entry for path, entry in self.cache.items() if path in self.used}
        self.used = set()


def listing(github, path, key):
    items, page = [], 1
    while True:
        batch = github.get(f'{path}per_page=100&page={page}')[key]
        items += batch
        if len(batch) < 100:
            return items
        page += 1


def runs_here(labels):
    return bool(labels) and {label.casefold() for label in labels} <= set(LABELS)


def queued_jobs(github, repo, older_than=0):
    runs = [run for status in ('queued', 'in_progress')
            for run in listing(github, f'repos/{repo}/actions/runs?status={status}&', 'workflow_runs')]
    cutoff = time.time() - older_than
    return sum(job['status'] == 'queued' and runs_here(job['labels']) and (not older_than or queued_at(job) <= cutoff)
               for run in runs for job in listing(github, f"repos/{repo}/actions/runs/{run['id']}/jobs?", 'jobs'))


def queued_at(job):
    return datetime.fromisoformat(job['created_at'][:19]).replace(tzinfo=timezone.utc).timestamp()


def standby_seconds():
    try:
        text = STANDBY.read_text().strip()
    except FileNotFoundError:
        return 0
    if not text.isdigit():
        raise ValueError(f'{STANDBY} must hold a whole number of seconds, not {text!r}')
    return int(text)


def burst_count(wanted, running, cpus, cores, load, available, total, vm_memory):
    """How many burst VMs to start: one per queued job, within a ceiling of one VM per CPU thread and per VM-sized
    share of RAM, and only while physical cores are free and RAM is available now."""
    ceiling = min(cpus, (total - HOST_RESERVE) // vm_memory)
    room = min(ceiling - running, int(cores - load), (available - HOST_RESERVE) // vm_memory)
    return max(0, min(wanted, room))


def physical_cores():
    try:
        online = (CPUS / 'online').read_text().strip()
    except FileNotFoundError:
        return os.cpu_count() or 1
    if not re.fullmatch(r'\d+(-\d+)?(,\d+(-\d+)?)*', online):
        raise ValueError(f'{CPUS / "online"} is not a CPU list: {online!r}')
    ranges = [(int(first), int(last or first)) for first, _, last in (part.partition('-') for part in online.split(','))]
    if any(last < first for first, last in ranges):
        raise ValueError(f'{CPUS / "online"} has a reversed range: {online!r}')
    cpus = [cpu for first, last in ranges for cpu in range(first, last + 1)]
    try:
        return len({(CPUS / f'cpu{cpu}' / 'topology' / 'core_cpus_list').read_text() for cpu in cpus})
    except FileNotFoundError:
        return len(cpus)


def process_start(pid):
    try:
        return Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def live_workers(folder):
    live = []
    for record in folder.glob('[0-9]*'):
        try:
            target, start, name, kind = json.loads(record.read_text())
        except (OSError, ValueError, TypeError):
            start = None
        if start and process_start(record.name) == start:
            live.append(argparse.Namespace(pid=int(record.name), target=target, name=name, kind=kind))
        else:
            record.unlink(missing_ok=True)
    return live


def note_worker(pid, target, name, kind):
    folder = STATE / 'workers'
    folder.mkdir(parents=True, exist_ok=True)
    staged = folder / f'.{pid}.{os.getpid()}'
    staged.write_text(json.dumps([target, process_start(pid), name, kind]))
    os.replace(staged, folder / str(pid))


def host_vms():
    return {vm['name'] for vm in json.loads(ic('list', '--format', 'json')) if vm['name'].startswith('cbx-')}


def host_load(workers, skip=None):
    vms = host_vms()
    orphans = len(vms - {worker.name for worker in workers})
    counted = [worker for worker in workers if not (worker.target == skip and worker.kind == 'base')]
    started = collections.Counter(worker.target for worker in workers if worker.kind == 'base')
    pending = sum(max(0, r['slots'] - started[r['target']]) for r in registrations()
                  if (r.get('configured') or r['active'] not in IDLE_UNIT) and r['target'] != skip)
    return orphans + len(counted) + pending


def additional_vm_memory(workers, memory):
    owned = host_vms() | {worker.name for worker in workers}
    committed = 0
    for vm in query('/1.0/instances?recursion=1&all-projects=true'):
        if vm['type'] != 'virtual-machine' or vm['status'] != 'Running':
            continue
        counted = memory if vm['project'] == PROJECT and vm['name'] in owned else 0
        limit = (vm.get('expanded_config') or {}).get('limits.memory') or (vm.get('config') or {}).get('limits.memory')
        committed += max(0, (size_bytes(limit) if limit else memory) - counted)
    return committed


def admit(target, name, kind):
    me = argparse.Namespace(pid=os.getpid(), target=target, name=name, kind=kind)
    with host_lock():
        workers = [worker for worker in live_workers(STATE / 'workers') if worker.pid != me.pid] + [me]
        memory = vm_memory()
        available = host_memory() - HOST_RESERVE - additional_vm_memory(workers, memory)
        if host_load(workers) > min(os.cpu_count(), available // memory):
            return False
        note_worker(me.pid, target, name, kind)
        return True


def host_lock():
    STATE.mkdir(parents=True, exist_ok=True)
    lock = os.fdopen(os.open(STATE / 'autoscale.lock', os.O_RDONLY | os.O_CREAT, 0o644))
    fcntl.flock(lock, fcntl.LOCK_EX)
    return lock


def starting(name, now):
    try:
        return now - int(name.split('-')[1]) < STARTING_SECONDS
    except (IndexError, ValueError):
        return False


def free_runners(runners, bursts, now):
    """Runners that can still take a queued job: online and idle, starting up, or a burst not yet on GitHub."""
    listed = {runner['name'] for runner in runners}
    free = sum(runner['name'].startswith('cbx-') and not runner['busy']
               and (runner['status'] == 'online' or starting(runner['name'], now)) for runner in runners)
    return free + sum(burst.name not in listed and starting(burst.name, now) for burst in bursts)


def autoscale(github, args, bursts):
    folder = STATE / 'workers'
    finished = [burst for burst in bursts if burst.poll() is not None]
    if finished:
        bursts[:] = [burst for burst in bursts if burst not in finished]
        with host_lock():
            live_workers(folder)
    repo = github.get(f'repos/{args.target}')
    if repo['full_name'].casefold() != args.target.casefold() or repo['visibility'] != 'private' and not args.allow_public:
        raise ValueError(f"{args.target} now resolves to {repo['visibility']} {repo['full_name']}; not scaling it")
    standby, seen = standby_seconds(), queued_jobs(github, args.target)
    queued = queued_jobs(github, args.target, standby) if standby and seen else seen
    idle = 0
    if queued:
        runners = listing(github, f'repos/{args.target}/actions/runners?', 'runners')
        idle = free_runners(runners, bursts, time.time())
    github.forget_unused()
    if seen and not queued:
        print(f'coldbox: standby host: {seen} job(s) on {args.target} queued under {standby} s are left to the '
              'primary host; started 0 burst runner(s)', file=sys.stderr, flush=True)
    if queued <= idle:
        return
    with host_lock():
        workers, memory = live_workers(folder), vm_memory()
        running = sum(worker.kind == 'burst' for worker in workers)
        booting = sum(worker.kind == 'burst' and starting(worker.name, time.time()) for worker in workers)
        vms, cores, load = host_load(workers), physical_cores(), os.getloadavg()[0] + booting
        add = 0 if STOPPING.is_set() else burst_count(queued - idle, vms, os.cpu_count(), cores, load,
                                                      host_memory('MemAvailable') - running * memory,
                                                      host_memory() - additional_vm_memory(workers, memory), memory)
        for _ in range(add):
            name = new_id()
            burst = subprocess.Popen(worker_argv(args, '--once', '--idle', str(BURST_IDLE_SECONDS), '--name', name))
            burst.name = name
            note_worker(burst.pid, args.target, name, 'burst')
            bursts.append(burst)
    print(f'coldbox: {queued} queued job(s) and {idle} idle runner(s) on {args.target}; '
          f'started {add} burst runner(s); host has {vms} job VM(s) and load {load:.1f} on {cores} cores',
          file=sys.stderr, flush=True)


def instance(target):
    return subprocess.run(['systemd-escape', target], check=True, capture_output=True, text=True).stdout.strip()


def registrations():
    listed = subprocess.run(['systemctl', 'list-units', 'coldbox-runner@*', '--all', '--plain', '--no-legend'],
                            capture_output=True, text=True).stdout
    found = []
    for line in listed.splitlines():
        unit, _load, active = line.split()[:3]
        escaped = unit.split('@', 1)[1].removesuffix('.service')
        target = subprocess.run(['systemd-escape', '--unescape', escaped], capture_output=True, text=True).stdout
        conf = Path(f'/etc/systemd/system/{unit}.d/coldbox.conf')
        match = re.search(r'COLDBOX_SLOTS=(\d+)', conf.read_text()) if conf.exists() else None
        found.append(dict(unit=unit, target=target.strip(), active=active, slots=int(match[1]) if match else 1,
                          configured=conf.exists()))
    return found


def vm_memory():
    return size_bytes(ic('profile', 'get', 'coldbox', 'limits.memory').strip())


def slots_text(slots):
    return f'{slots} job VM slot(s)' if slots else 'burst only: 0 slots, VMs start only for queued jobs'


def register(args):
    if args.slots < 0 or args.slots == 0 and '/' not in args.target:
        raise SystemExit('coldbox: --slots must be at least 1 for an org; 0 (burst only) needs OWNER/REPO')
    with host_lock():
        return register_locked(args)


def register_locked(args):
    memory, host, cpus = vm_memory(), host_memory(), os.cpu_count()
    total = args.slots + host_load(live_workers(STATE / 'workers'), skip=args.target)
    if args.slots and (not fits(total, memory, host) or total > cpus):
        raise SystemExit(f'coldbox: {total} job VMs of {memory / 2**30:g} GiB, counting running burst '
                         f'VMs, do not fit in {host / 2**30:.0f} GiB of RAM (2 GiB stays with the host) and '
                         f'{cpus} CPU threads (one VM each). Use fewer --slots, wait for bursts to finish, or '
                         'reinstall with a smaller COLDBOX_MEMORY.')
    guard(args.target, args.allow_public)
    unit = f'coldbox-runner@{instance(args.target)}.service'
    dropin = f'[Service]\nEnvironment=COLDBOX_ALLOW_PUBLIC={int(args.allow_public)}\n' \
             f'Environment=COLDBOX_ALLOW_FORKS={int(args.allow_forks)}\nEnvironment=COLDBOX_SLOTS={args.slots}\n'
    subprocess.run(['sudo', 'mkdir', '-p', f'/etc/systemd/system/{unit}.d'], check=True)
    subprocess.run(['sudo', 'tee', f'/etc/systemd/system/{unit}.d/coldbox.conf'], input=dropin, text=True,
                   check=True, stdout=subprocess.DEVNULL)
    subprocess.run(['sudo', 'systemctl', 'daemon-reload'], check=True)
    subprocess.run(['sudo', 'systemctl', 'enable', unit], check=True)
    subprocess.run(['sudo', 'systemctl', 'restart', '--no-block', unit], check=True)
    print(f'coldbox: {unit} running {slots_text(args.slots)}. '
          f'Add runs-on: [self-hosted, coldbox] to a workflow in {args.target}.')
    return 0


def unregister(args):
    unit = f'coldbox-runner@{instance(args.target)}.service'
    subprocess.run(['sudo', 'systemctl', 'disable', '--now', unit], check=False)
    subprocess.run(['sudo', 'rm', '-rf', f'/etc/systemd/system/{unit}.d'], check=True)
    subprocess.run(['sudo', 'systemctl', 'daemon-reload'], check=True)
    listed = subprocess.run(['gh', 'api', '--paginate', f'{scope(args.target)}/actions/runners?per_page=100', '--jq',
                             '.runners[] | select(.name | startswith("cbx-")) | .id'], capture_output=True, text=True)
    if listed.returncode:
        raise RuntimeError(f'gh api runners: {listed.stderr.strip()}')
    ids = listed.stdout.split()
    for runner_id in ids:
        gh('-X', 'DELETE', f'{scope(args.target)}/actions/runners/{runner_id}')
    print(f'coldbox: stopped {unit}; deleted {len(ids)} coldbox runner registration(s) from {args.target}')
    return 0


def reap(args):
    failed = 0
    try:
        sync_acl()
    except Exception as error:
        failed += 1
        print(f'coldbox reap: FAILED to refresh network ACL: {error}', file=sys.stderr)
    for vm in json.loads(ic('list', '--format', 'json')):
        if not vm['name'].startswith('cbx-'):
            continue
        try:
            expires = int((vm.get('config') or {})['user.coldbox.expires'])
        except (KeyError, TypeError, ValueError):
            print(f"coldbox reap: skipped {vm['name']}: no readable user.coldbox.expires", file=sys.stderr)
            continue
        if expires < time.time():
            gone = destroy(vm['name'])
            failed += not gone
            print(f"coldbox reap: {vm['name']} {'deleted' if gone else 'FAILED to delete'}")
    if args.keep_days > 0:
        cutoff = time.time() - args.keep_days * 86400
        old = [path for path in (STATE / 'receipts').glob('cbx-*') if path.stat().st_mtime < cutoff]
        for path in old:
            path.unlink(missing_ok=True)
        if old:
            print(f'coldbox reap: deleted {len(old)} receipt file(s) older than {args.keep_days} days')
    return int(bool(failed))


def fetch_json(url):
    request = urllib.request.Request(url, headers={'Accept': 'application/vnd.github+json', 'User-Agent': 'coldbox'})
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response)


