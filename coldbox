def incus_crashes(version):
    match = re.match(r'6\.(\d+)\.?(\d*)', version)
    return bool(match) and (int(match[2] or 0) < 6 if match[1] == '0' else int(match[1]) <= 21)


def kvm_fix():
    try:
        virt = subprocess.run(['systemd-detect-virt'], capture_output=True, text=True).stdout.strip()
    except OSError:
        virt = ''
    if virt in ('', 'none'):
        return 'enable VT-x/AMD-V in the BIOS'
    if virt == 'wsl':
        return 'WSL2 gives Coldbox no KVM, so run it on a Linux machine, see README.md#wsl2'
    return f'this host is a {virt} VM or container, so Coldbox needs nested virtualization from its provider, see docs/vps.md'


def build_id():
    return hashlib.sha256(Path(__file__).resolve().read_bytes()).hexdigest()[:12]


def check_visibility(registration, check):
    target = registration['target']
    registration['visibility'] = 'unknown'
    try:
        repo = gh(scope(target))
        registration['visibility'] = repo['visibility']
        if repo['visibility'] == 'private':
            return
        if not registration.get('allow_public'):
            hosted = f"move {target}'s workflows to GitHub-hosted runners"
            check(False, f"{target} is {repo['visibility']} and registered without --allow-public, so no jobs run",
                  f"{hosted}, or, with the owner's approval, set its fork-pr-contributor-approval to {APPROVAL} "
                  f"and run coldbox register {target} --slots {registration['slots']} --allow-public"
                  if (repo.get('owner') or {}).get('type') == 'User' else
                  f'{hosted}; --allow-public serves only repos owned by a user account')
        else:
            writers = public_writers(gh, target, repo)
            check(True, f"{target} is {repo['visibility']} with --allow-public: jobs from "
                  f"{', '.join(writers) or 'nobody'} (write access) run without approval", '')
    except Unsafe as error:
        check(False, f'{target}: {error}', 'fix that, or move its workflows to GitHub-hosted runners')
    except (OSError, RuntimeError, ValueError, KeyError, TypeError) as error:
        check(False, f'{target}: visibility unreadable from GitHub: {error}', 'fix GitHub auth, then rerun')


GUEST_DIGEST = '''set -euo pipefail
export LC_ALL=C
cd "$1"
entries=$(find . -mindepth 1 -maxdepth 1 -printf '%P\\n' | sort)
while IFS= read -r e; do
    [ -n "$e" ] || continue
    d=$({ find "$e" -printf '%y %m %p %l\\n' | sort; find "$e" -type f -print0 | sort -z | xargs -0r sha256sum; } |
        sha256sum | cut -c1-16)
    printf '%s %s\\n' "$d" "$e"
done <<< "$entries"'''


def guest_digests(host):
    command = ['bash', '-c', GUEST_DIGEST, 'bash', str(GUEST_FILES / 'opt')]
    result = subprocess.run(command if host == os.uname().nodename else ssh(host, command),
                            capture_output=True, text=True, timeout=60, check=True)
    return {name: digest for digest, name in (line.split(' ', 1) for line in result.stdout.splitlines())}


def check_guest_drift(check):
    try:
        host, policy = admitted_fleet()
    except RuntimeError as error:
        check(False, f'guest overlay drift unchecked: {error}', f'fix {CI_HOSTS}')
        return
    peers = [peer for peer in [policy[0], *policy[1]] if peer != host] if policy else []
    if not peers:
        return
    drift = []
    try:
        mine = guest_digests(host)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        mine, drift = {}, [f'{host}: unreadable ({error})']
    for peer in peers:
        try:
            theirs = guest_digests(peer)
        except (OSError, ValueError, subprocess.SubprocessError):
            drift.append(f'{peer}: unreadable')
            continue
        drift += [f'{peer}: opt/{name}' for name in sorted(mine.keys() | theirs.keys()) if mine.get(name) != theirs.get(name)]
    check(not drift, f"guest overlay {GUEST_FILES / 'opt'} matches {' '.join(peers)}"
          f"{': differs on ' if drift else ''}{', '.join(drift)}",
          'run sudo systemctl start coldbox-refresh.service on every CI host so all copy the same commits')


