CI_HOSTS = Path('/etc/coldbox/ci-hosts.json')
CI_HOSTS_HELP = ('it must hold {"primary": "<host>", "overflow": ["<host>", ...]} with distinct kernel host names, '
                 'none in overflow equal to the primary. See https://github.com/TayHCode/coldbox#autoscaling')


def fleet():
    try:
        CI_HOSTS.lstat()
    except FileNotFoundError:
        return None
    except OSError as error:
        raise RuntimeError(f'CI host admission denied: cannot read {CI_HOSTS}: {error}; {CI_HOSTS_HELP}') from error
    try:
        policy = json.loads(CI_HOSTS.read_text())
        primary, overflow = policy['primary'], policy['overflow']
        if (not isinstance(primary, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', primary)
                or not isinstance(overflow, list) or len(set(overflow)) != len(overflow)
                or any(not isinstance(h, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', h)
                       or h == primary for h in overflow)):
            raise ValueError('invalid CI hosts')
        return primary, overflow
    except (OSError, ValueError, KeyError, TypeError) as error:
        detail = f'missing key {error}' if isinstance(error, KeyError) else error
        raise RuntimeError(f'CI host admission denied: cannot read {CI_HOSTS}: {detail}; {CI_HOSTS_HELP}') from error


def admitted_fleet():
    host, policy = os.uname().nodename, fleet()
    if policy and host != policy[0] and host not in policy[1]:
        raise RuntimeError(f'CI host admission denied: {host} is not admitted for CI: it is not listed in {CI_HOSTS}; '
                           f'to run CI here, add it to "overflow"; {CI_HOSTS_HELP}')
    return host, policy


def ci_host():
    host, policy = admitted_fleet()
    return host, policy[0] if policy else host


def adhoc_peers():
    try:
        host, policy = admitted_fleet()
    except RuntimeError:
        return []
    return [peer for peer in policy[1] if peer != host] if policy else []


def fresh_evidence(evidence, host, target, at):
    if not isinstance(evidence, dict):
        return False
    fields = ('measured_at', 'cpus', 'busy_cpus', 'load_avg', 'available_memory', 'vm_memory', 'vms', 'vm_ceiling')
    if any(type(evidence.get(k)) not in (int, float) or not math.isfinite(evidence[k]) for k in fields):
        return False
    return (evidence.get('host') == host and evidence.get('target') == target
            and 0 <= at - evidence['measured_at'] <= 30
            and evidence['cpus'] > 0 and 0 <= evidence['busy_cpus'] <= evidence['cpus'] and evidence['load_avg'] >= 0
            and evidence['available_memory'] >= 0 and evidence['vm_memory'] > 0 and evidence['vms'] >= 0)


def ssh(host, command):
    return ['ssh', '-T', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=3', '-o', 'StrictHostKeyChecking=yes',
            host, shlex.join(command)]


def host_evidence(target, host):
    try:
        result = subprocess.run(['python3', '-'] if host == os.uname().nodename else ssh(host, ['python3', '-']),
                                input=f'requested_target = {target!r}\n' + HOST_PROBE,
                                capture_output=True, text=True, timeout=8, check=True)
        return json.loads(result.stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def least_loaded(hosts, target):
    with concurrent.futures.ThreadPoolExecutor(max(len(hosts), 1)) as pool:
        evidence = list(pool.map(lambda host: host_evidence(target, host), hosts))
    at, rooms, seen = time.time(), [], []
    for index, (host, measured) in enumerate(zip(hosts, evidence)):
        if (fresh_evidence(measured, host, target, at)
                and all(type(measured.get(k)) is int and measured[k] >= 0 for k in ('reserve', 'ramp_room', 'booting'))
                and type(measured.get('load_avg')) in (int, float) and 0 <= measured['load_avg'] < math.inf):
            load = max(measured['busy_cpus'], measured['load_avg'])
            room = min(int(measured['cpus'] - load - measured['booting']),
                       int(measured['vm_ceiling'] - measured['vms']), measured['ramp_room'],
                       int((measured['available_memory'] - HOST_RESERVE) // measured['vm_memory']))
            seen.append(f"{host} room {room} (busy {measured['busy_cpus']:.1f}, load {measured['load_avg']:.1f}, "
                        f"booting {measured['booting']}, {measured['vms']}/{measured['vm_ceiling']} VMs, "
                        f"{measured['cpus']} CPUs)")
            if room >= 1:
                rooms.append((-room, index, host))
        else:
            seen.append(f'{host} unmeasured')
    print(f"coldbox: least-load ranking: {'; '.join(seen)}", file=sys.stderr, flush=True)
    return [host for _, _, host in sorted(rooms)]


def runner_admission(target, name, expires):
    host, primary = ci_host()
    now = time.time()
    return dict(schema='coldbox.admission/v1', host=host, primary=primary, target=target,
                guest=name, admitted_at=now, ttl=int(expires - now), primary_capacity=None)


def admission_check(args, env=None):
    env = os.environ if env is None else env
    try:
        record = json.loads(Path('/etc/coldbox/admission.json').read_text())
        host = Path('/etc/coldbox/host').read_text().strip()
        if (record['schema'] != 'coldbox.admission/v1' or record['host'] != host
                or record['primary'] != args.expected_primary
                or record['guest'] != env['RUNNER_NAME']
                or not (record['target'].casefold() == env['GITHUB_REPOSITORY'].casefold()
                        or ('/' not in record['target'] and record['target'].casefold() ==
                            env['GITHUB_REPOSITORY'].split('/')[0].casefold()))
                or type(record['admitted_at']) not in (int, float)
                or not math.isfinite(record['admitted_at'])
                or time.time() < record['admitted_at']):
            raise ValueError('admission identity or time mismatch')
        if type(record['ttl']) is not int or record['ttl'] <= 0 or time.time() - record['admitted_at'] > record['ttl']:
            raise ValueError('admission outlived its VM TTL')
    except (OSError, ValueError, KeyError, TypeError) as error:
        raise RuntimeError(f'CI admission guard failed: {error}') from error
    print(json.dumps(record))
    return 0


def process_start(pid):
    try:
        return Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def worker_record(record):
    try:
        fields = json.loads(record.read_text())
        target, start, name, kind, *writers = fields if isinstance(fields, list) else ()
    except (OSError, ValueError, TypeError):
        return None
    if len(writers) > 2 or len(writers) == 2 and (type(writers[1]) is not int or writers[1] <= 0):
        return None
    return target, start, name, kind, writers


def unreadable_live_workers(folder):
    return [record.name for record in folder.glob('[0-9]*')
            if process_start(record.name) is not None and worker_record(record) is None]


def live_workers(folder, prune=True):
    live = []
    for record in folder.glob('[0-9]*'):
        running = process_start(record.name)
        fields = worker_record(record)
        if fields is None:
            if prune and running is None:
                record.unlink(missing_ok=True)
            continue
        target, start, name, kind, writers = fields
        if start and running == start:
            live.append(argparse.Namespace(pid=int(record.name), target=target, name=name, kind=kind,
                                           writers=writers[0] if writers else None,
                                           memory=writers[1] if len(writers) > 1 else None))
        elif prune:
            record.unlink(missing_ok=True)
    return live


def note_worker(pid, target, name, kind, writers=None, memory=None):
    folder = STATE / 'workers'
    folder.mkdir(parents=True, exist_ok=True)
    staged = folder / f'.{pid}.{os.getpid()}'
    staged.write_text(json.dumps([target, process_start(pid), name, kind, writers] + ([memory] if memory else [])))
    os.replace(staged, folder / str(pid))


def orphan(vm, live):
    return vm['name'] not in live and (vm.get('config') or {}).get(ADHOC) != 'true'


def past_ttl(receipt, now):
    try:
        ttl = receipt['vm']['ttl_seconds']
        if type(ttl) is not int or ttl < 0:
            return True
        return at(receipt['started_at']) + ttl < now
    except (KeyError, TypeError, ValueError, OverflowError):
        return True


def unreconciled(live):
    for path in sorted((STATE / 'receipts').glob('cbx-*.json')):
        try:
            receipt = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(receipt, dict) and isinstance(receipt.get('vm'), dict) and isinstance(receipt.get('id'), str) \
                and receipt['vm'].get('destroyed') is False and receipt['id'] not in live:
            yield path, receipt


def host_vms():
    rows = json.loads(ic('list', '--format', 'json', '--columns', 'n'))
    return {vm['name'] for vm in rows if vm['name'].startswith('cbx-')}


def waiting(worker):
    if worker.kind != 'base':
        return False
    try:
        return not running_job((STATE / 'receipts' / f'{worker.name}.log').read_bytes())
    except FileNotFoundError:
        return True


def holds_slots(registration):
    return registration.get('configured') or registration['active'] not in IDLE_UNIT


def host_load(workers):
    """Count this host's job VMs as (busy, warm). Warm ones are slot VMs still waiting for a job; every other Coldbox
    VM is busy."""
    return capacity_used(workers), sum(map(waiting, workers))


def vm_bytes(worker, memory):
    return getattr(worker, 'memory', None) or memory


def additional_vm_memory(workers, memory, vms=None):
    sizes = {worker.name: vm_bytes(worker, memory) for worker in workers}
    owned = (host_vms() if vms is None else vms) | set(sizes)
    committed = 0
    for vm in query('/1.0/instances?recursion=1&all-projects=true'):
        if vm['type'] != 'virtual-machine' or vm['status'] != 'Running':
            continue
        counted = sizes.get(vm['name'], memory) if vm['project'] == PROJECT and vm['name'] in owned else 0
        limit = (vm.get('expanded_config') or {}).get('limits.memory') or (vm.get('config') or {}).get('limits.memory')
        committed += max(0, (size_bytes(limit) if limit else memory) - counted)
    return committed


def capacity_used(workers):
    """Busy job VMs: every Coldbox VM and worker except slot VMs still waiting for a job."""
    return len(host_vms() - {worker.name for worker in workers}) + len(workers) - sum(map(waiting, workers))


def host_room(workers, memory, need, load, reserve, vms=None):
    """Room for job VMs of need bytes beside workers and every Coldbox VM on this host, by each admission check."""
    host, vms = host_memory(), host_vms() if vms is None else vms
    untracked = vms - {worker.name for worker in workers}
    extra = additional_vm_memory(workers, memory, vms)
    committed = sum(vm_bytes(worker, memory) for worker in workers) + len(untracked) * memory + extra
    available = host_memory('MemAvailable') - extra - sum(map(unready, untracked)) * memory - \
        sum(vm_bytes(worker, memory) for worker in workers if unready(worker.name))
    return rooms(len(untracked) + len(workers), os.cpu_count(), load, available, memory_floor(host), need, reserve,
                 (host - host_share(host) - committed) // need)


def vm_room():
    """Count job VMs without the host lock, as (busy, the most busy VMs the admission rule allows now). Workers are
    read between two VM listings and only VMs in both count, so every counted worker or VM existed when the workers
    were read."""
    memory, listed = vm_memory(), host_vms()
    workers = live_workers(STATE / 'workers', prune=False)
    vms = listed & host_vms()
    used = len(vms - {worker.name for worker in workers}) + len(workers) - sum(map(waiting, workers))
    if storage_refusal():
        return used, used
    room = host_room(workers, memory, memory, os.getloadavg()[0], host_setting(RESERVE, 'CPU threads'), vms)
    return used, used + burst_count(math.inf, room)


def admit(target, name, kind, writers=None, memory=None):
    me = argparse.Namespace(pid=os.getpid(), target=target, name=name, kind=kind, writers=writers, memory=memory)
    with host_lock():
        workers = [worker for worker in live_workers(STATE / 'workers') if worker.pid != me.pid] + [me]
        memory = vm_memory()
        if kind == 'vm' and VM_MAX.exists():
            cap = host_setting(VM_MAX, 'VMs')
            if len({worker.name for worker in workers if worker.kind == 'vm'} | set(adhoc_vms())) > cap:
                raise SystemExit(f'coldbox: {cap} ad-hoc VM(s) already running, the limit in {VM_MAX}; '
                                 'coldbox vm down one first')
        ci = kind != 'vm'
        room = host_room([worker for worker in workers if worker is not me], memory, vm_bytes(me, memory),
                         os.getloadavg()[0] if ci else 0, host_setting(RESERVE, 'CPU threads') if ci else 0)
        if not burst_count(1, room):
            print(f'coldbox: no room for a job VM: {declined(room)} ({room})', file=sys.stderr, flush=True)
            return False
        refusal = storage_refusal()
        if refusal:
            print(refusal, file=sys.stderr, flush=True)
            return False
        note_worker(me.pid, target, name, kind, writers, me.memory)
        return True


def host_lock():
    STATE.mkdir(parents=True, exist_ok=True)
    lock = os.fdopen(os.open(STATE / 'autoscale.lock', os.O_RDONLY | os.O_CREAT, 0o644))
    fcntl.flock(lock, fcntl.LOCK_EX)
    return lock


def unready(name):
    if (STATE / 'ready' / name).exists():
        return False
    try:
        return not (STATE / 'receipts' / f'{name}.log').stat().st_size
    except OSError:
        return True


def starting(name, now):
    try:
        return now - int(name.split('-')[1]) < STARTING_SECONDS
    except (IndexError, ValueError):
        return False


def free_runners(runners, bursts, now):
    """Runners that can still take a queued job, by size: online and idle, starting up, or a burst not yet on GitHub."""
    listed = {runner['name'] for runner in runners}
    free = collections.Counter(job_size(label['name'] for label in runner.get('labels', ())) or 'default'
                               for runner in runners if runner['name'].startswith('cbx-') and not runner['busy']
                               and (runner['status'] == 'online' or starting(runner['name'], now)))
    free.update(getattr(burst, 'size', 'default') for burst in bursts
                if burst.name not in listed and starting(burst.name, now))
    return free


def autoscale(github, args, bursts):
    """Start a burst runner for each queued job no free runner can take, and return the seconds to wait before the
    next pass."""
    folder = STATE / 'workers'
    finished = [burst for burst in bursts if burst.poll() is not None]
    if finished:
        bursts[:] = [burst for burst in bursts if burst not in finished]
        with host_lock():
            live_workers(folder)
    try:
        writers = public_rules(github, args)
    except Unsafe:
        release_waiting(github, args.target, lambda worker: True)
        raise
    release_waiting(github, args.target, lambda worker: worker.writers != writers)
    reserve = host_setting(RESERVE, 'CPU threads')
    seen, oldest, sizes = observe_queue(github, args.target, writers=writers)
    if seen:
        print(f'coldbox: queue on {args.target}: {seen} queued job(s); oldest waited {oldest} s',
              file=sys.stderr, flush=True)
    idle = collections.Counter()
    if seen:
        runners = listing(github, f'repos/{args.target}/actions/runners?', 'runners')
        idle = free_runners(runners, bursts, time.time())
    github.forget_unused()
    wanted = {size: sizes[size] - idle[size] for size in SIZES if sizes[size] > idle[size]}
    raw_load, cpu_load = (os.getloadavg()[0], host_cpu_load()) if wanted else (0, 0)
    for size, extra in wanted.items():
        size_memory, _ = vm_shape(size)
        with host_lock():
            workers, memory = live_workers(folder), vm_memory()
            need = size_memory or memory
            booting = sum(worker.kind == 'burst' and starting(worker.name, time.time()) for worker in workers)
            (vms, warm), cpus = host_load(workers), os.cpu_count()
            load = max(cpu_load, raw_load) + booting
            room = host_room(workers, memory, need, load, reserve)
            stopping = STOPPING.is_set()
            add = 0 if stopping else burst_count(extra, room)
            refusal = add and storage_refusal()
            if refusal:
                print(refusal, file=sys.stderr, flush=True)
                add = 0
            uncapped = add
            add = ramp_room(add, vms)
            for _ in range(add):
                name = new_id()
                burst = subprocess.Popen(worker_argv(args, '--once', '--idle', str(BURST_IDLE_SECONDS), '--name',
                                                     name, *(['--size', size] if size != 'default' else [])))
                burst.name, burst.size = name, size
                note_worker(burst.pid, args.target, name, 'burst', None, size_memory)
                bursts.append(burst)
        print(f'coldbox: {sizes[size]} queued job(s) and {idle[size]} idle runner(s) on {args.target}'
              + (f' for {size} VMs' if size != 'default' else '') +
              f'; oldest waited {oldest} s; started {add} burst runner(s); host has {vms} busy and {warm} warm job VM(s) and load {load:.1f} on '
              f'{cpus} CPU threads' + (f' ({reserve} reserved)' if reserve else '') +
              f'; raw load {raw_load:.1f}; booting {booting}; room {room}; VM memory {need}; stopping {stopping}' +
              (f'; declined by {declined(room)}' if add < extra and not stopping else '') +
              (f'; ramp admitted {add} of {uncapped}' if (STATE / 'ramp-cap.json').exists() else ''),
              file=sys.stderr, flush=True)
    return AUTOSCALE_SECONDS


def public_rules(github, args):
    repo = github.get(f'repos/{args.target}')
    if repo['full_name'].casefold() != args.target.casefold() or repo['visibility'] != 'private' and not args.allow_public:
        raise Unsafe(f"{args.target} now resolves to {repo['visibility']} {repo['full_name']}; not scaling it")
    return None if repo['visibility'] == 'private' else public_writers(github.get, args.target, repo)


def release_waiting(github, target, stale):
    """Deregister this host's idle runners for target whose worker holds stale approval rules, and wake those workers
    so they start over with fresh rules. Runs every pass, so a failed delete or a runner registered after the rules
    changed is caught next time. GitHub refuses to delete a busy runner, so running jobs keep going."""
    with host_lock():
        pids = {worker.name: worker.pid for worker in live_workers(STATE / 'workers')
                if worker.target == target and stale(worker)}
    if not pids:
        return
    released = len(release(github, target, pids, len(pids)))
    print(f'coldbox: released {released} waiting runner(s) on {target} that held out-of-date approval rules; '
          f'running jobs keep going', file=sys.stderr, flush=True)


def release(github, target, pids, limit):
    """Delete up to limit idle runners of target named in pids and wake their workers, which destroy the VM.
    GitHub refuses to delete a runner that has taken a job, so a job never loses its runner."""
    released = []
    for runner in listing(github, f'{scope(target)}/actions/runners?', 'runners'):
        if len(released) == limit:
            break
        if runner['name'] not in pids or runner['busy']:
            continue
        try:
            gh('-X', 'DELETE', f"{scope(target)}/actions/runners/{runner['id']}")
            os.kill(pids[runner['name']], signal.SIGUSR1)
        except (RuntimeError, OSError):
            continue
        released.append(runner['name'])
    return released


def instance(target):
    return subprocess.run(['systemd-escape', target], check=True, capture_output=True, text=True).stdout.strip()


def registrations():
    listed = subprocess.run(['systemctl', 'list-units', 'coldbox-runner@*', '--all', '--plain', '--no-legend'],
                            capture_output=True, text=True).stdout
    found = []
    for line in listed.splitlines():
        unit, _load, active = line.split()[:3]
        escaped = unit.split('@', 1)[1].removesuffix('.service')
        target = subprocess.run(['systemd-escape', '--unescape', escaped], capture_output=True, text=True).stdout
        conf = Path(f'/etc/systemd/system/{unit}.d/coldbox.conf')
        text = conf.read_text() if conf.exists() else ''
        match = re.search(r'COLDBOX_SLOTS=(\d+)', text)
        found.append(dict(unit=unit, target=target.strip(), active=active, slots=int(match[1]) if match else 1,
                          configured=conf.exists(), allow_public='COLDBOX_ALLOW_PUBLIC=1\n' in text))
    return found


def vm_memory():
    return size_bytes(ic('profile', 'get', 'coldbox', 'limits.memory').strip())


def vm_disk():
    return size_bytes(ic('profile', 'device', 'get', 'coldbox', 'root', 'size').strip())


def storage_refusal():
    space = query(f'/1.0/storage-pools/{POOL}/resources')['space']
    free, disk, reserve = space['total'] - space['used'], vm_disk(), space['total'] // 10
    if free < disk + reserve:
        return (f'coldbox: storage pool {POOL} has {free / 2**30:.0f} GiB free, below one {disk / 2**30:g} GiB root '
                f'disk plus a {reserve / 2**30:.0f} GiB reserve; run coldbox reap, or reinstall with a larger '
                'COLDBOX_POOL_SIZE')
    return None


def slots_text(slots):
    return f'{slots} job VM slot(s)' if slots else 'burst only: 0 slots, VMs start only for queued jobs'


def register(args):
    ci_host()
    if args.allow_public and args.allow_forks:
        raise SystemExit('coldbox: --allow-public and --allow-forks cannot be combined: on a public repo, pull '
                         'requests from users without write access run only after you approve them on GitHub')
    if args.slots < 0 or args.slots == 0 and '/' not in args.target:
        raise SystemExit('coldbox: --slots must be at least 1 for an org; 0 (burst only) needs OWNER/REPO')
    with host_lock():
        return register_locked(args)


def register_locked(args):
    memory, host, reserve = vm_memory(), host_memory(), host_setting(RESERVE, 'CPU threads')
    others = sum(r['slots'] for r in registrations() if holds_slots(r) and r['target'] != args.target)
    limit = slot_limit(memory, host, reserve)
    if args.slots and others + args.slots > limit:
        raise SystemExit(f'coldbox: {others + args.slots} slot VMs of {memory / 2**30:g} GiB, counting every '
                         f'registered slot, plus one {large_memory(memory, host) / 2**30:g} GiB large VM exceed '
                         f'the ceiling of {host / 2**30:.0f} GiB of RAM ({host_share(host) / 2**30:g} GiB stays '
                         f'with the host) and {os.cpu_count()} CPU threads ({reserve} reserved, {CORES_PER_JOB} per VM), so a '
                         f'job no idle slot can take could wait forever. Lower --slots to at most '
                         f'{max(0, limit - others)}' + ('.' if limit == vm_bound(reserve) - 1 else
                                                        ' or reinstall with a smaller COLDBOX_MEMORY.'))
    writers = guard(args.target, args.allow_public)
    unit = f'coldbox-runner@{instance(args.target)}.service'
    dropin = f'[Service]\nEnvironment=COLDBOX_ALLOW_PUBLIC={int(args.allow_public)}\n' \
             f'Environment=COLDBOX_ALLOW_FORKS={int(args.allow_forks)}\nEnvironment=COLDBOX_SLOTS={args.slots}\n'
    subprocess.run(['sudo', 'mkdir', '-p', f'/etc/systemd/system/{unit}.d'], check=True)
    subprocess.run(['sudo', 'tee', f'/etc/systemd/system/{unit}.d/coldbox.conf'], input=dropin, text=True,
                   check=True, stdout=subprocess.DEVNULL)
    subprocess.run(['sudo', 'systemctl', 'daemon-reload'], check=True)
    subprocess.run(['sudo', 'systemctl', 'enable', unit], check=True)
    subprocess.run(['sudo', 'systemctl', 'restart', '--no-block', unit], check=True)
    print(f'coldbox: {unit} running {slots_text(args.slots)}. '
          f'Add runs-on: [self-hosted, coldbox] to a workflow in {args.target}; '
          'coldbox detect --workflow prints one.')
    if writers is not None:
        print(f"coldbox: {args.target} is public. Jobs triggered by {', '.join(writers) or 'nobody'} (write access) "
              'run at once; pull requests from anyone else run only after you approve them on GitHub.')
    return 0


def unregister(args):
    unit = f'coldbox-runner@{instance(args.target)}.service'
    subprocess.run(['sudo', 'systemctl', 'disable', '--now', unit], check=False)
    subprocess.run(['sudo', 'rm', '-rf', f'/etc/systemd/system/{unit}.d'], check=True)
    subprocess.run(['sudo', 'systemctl', 'daemon-reload'], check=True)
    env = gh_env(scope(args.target))
    listed = subprocess.run(['gh', 'api', '--paginate', f'{scope(args.target)}/actions/runners?per_page=100', '--jq',
                             '.runners[] | select(.name | startswith("cbx-")) | "\\(.id) \\(.name)"'],
                            capture_output=True, text=True, env=env)
    if listed.returncode:
        raise RuntimeError('GitHub App runner listing failed' if env else f'gh api runners: {listed.stderr.strip()}')
    ids = [runner_id for runner_id, name in (line.split(' ', 1) for line in listed.stdout.splitlines())
           if re.fullmatch(r'cbx-[A-Za-z0-9-]+', name)
           and any((STATE / 'receipts' / f'{name}{kind}').exists() for kind in ('.json', '.registered'))]
    for runner_id in ids:
        gh('-X', 'DELETE', f'{scope(args.target)}/actions/runners/{runner_id}')
    print(f'coldbox: stopped {unit}; deleted {len(ids)} coldbox runner registration(s) this host started '
          f'from {args.target}')
    return 0


def reap(args):
    failed = 0
    try:
        sync_acl()
    except Exception as error:
        failed += 1
        print(f'coldbox reap: FAILED to refresh network ACL: {error}', file=sys.stderr)
    with host_lock():
        live = {worker.name for worker in live_workers(STATE / 'workers')}
        unreadable = unreadable_live_workers(STATE / 'workers')
        listed = json.loads(ic('list', '--format', 'json'))
        vms = [vm for vm in listed if vm['name'].startswith('cbx-')]
    if unreadable:
        print(f"coldbox reap: kept worker-less VMs: cannot read the records of live worker(s) {', '.join(unreadable)}",
              file=sys.stderr)
    for vm in vms:
        if orphan(vm, live) and not unreadable:
            gone = destroy(vm['name'])
            failed += not gone
            print(f"coldbox reap: {vm['name']} has no live worker; {'deleted' if gone else 'FAILED to delete'}")
            continue
        try:
            expires = int((vm.get('config') or {})['user.coldbox.expires'])
        except (KeyError, TypeError, ValueError):
            try:
                expires = int(vm['name'].split('-')[1]) + 86400
            except (IndexError, ValueError):
                expires = float('inf')
            if expires >= time.time():
                print(f"coldbox reap: skipped {vm['name']}: no readable user.coldbox.expires", file=sys.stderr)
                continue
        if expires < time.time():
            gone = destroy(vm['name'])
            failed += not gone
            print(f"coldbox reap: {vm['name']} {'deleted' if gone else 'FAILED to delete'}")
    if any(vm['name'] == 'base-smoke' for vm in listed):
        try:
            with open(STATE / 'build-base.lock') as lock:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                gone = destroy('base-smoke')
        except OSError as error:
            print(f'coldbox reap: skipped base-smoke: build-base lock not free: {error}', file=sys.stderr)
        else:
            failed += not gone
            print(f"coldbox reap: base-smoke left by an interrupted build-base; "
                  f"{'deleted' if gone else 'FAILED to delete'}")
    if any(not vm['name'].startswith('cbx-') and vm['name'] != 'base-smoke' for vm in listed):
        try:
            with open(STATE / 'build-base.lock') as lock:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                failed += reap_bases(json.loads(ic('list', '--format', 'json')))
        except OSError as error:
            print(f'coldbox reap: skipped bases: build-base lock not free: {error}', file=sys.stderr)
    with host_lock():
        live, present = {worker.name for worker in live_workers(STATE / 'workers')}, host_vms()
        for path, receipt in unreconciled(live):
            if receipt['id'] in present:
                continue
            receipt['vm'].update(destroyed=True, destroyed_at=now_iso())
            receipt['reconciled_by'] = 'coldbox reap'
            settle(receipt)
            write_json(path, receipt)
            print(f"coldbox reap: finalized {receipt['id']} receipt as {receipt['verdict']}: VM gone, no live worker")
    if args.keep_days > 0:
        cutoff = time.time() - args.keep_days * 86400
        receipts = STATE / 'receipts'
        old = [path for path in receipts.glob('cbx-*') if path.is_file() and path.stat().st_mtime < cutoff]
        for path in old:
            path.unlink(missing_ok=True)
        for folder in receipts.glob('cbx-*.artifacts'):
            if folder.is_dir() and not (receipts / f"{folder.name.removesuffix('.artifacts')}.json").exists():
                shutil.rmtree(folder)
        if old:
            print(f'coldbox reap: deleted {len(old)} receipt file(s) older than {args.keep_days} days')
    return int(bool(failed))


def rollback_pending():
    try:
        return json.loads((STATE / 'base-rollback.json').read_text())['mode'] != 'complete'
    except FileNotFoundError:
        return False
    except (OSError, ValueError, KeyError, TypeError):
        return True


def retire_live_base():
    try:
        ic('config', 'set', 'base-dev', f'{MANAGED}=true', f'{EXPIRES}={int(time.time() + ROLLBACK_WINDOW)}')
    except subprocess.CalledProcessError as error:
        if 'not found' not in (error.stderr or '').lower():
            raise


def reap_bases(vms):
    failed, pending = 0, rollback_pending()
    for vm in vms:
        name, config = vm['name'], vm.get('config') or {}
        if name.startswith('cbx-') or name == 'base-smoke':
            continue
        expires = config.get(EXPIRES, '')
        if name == 'base-dev' and (config.get(MANAGED), expires) != ('true', 'never'):
            ic('config', 'set', name, f'{MANAGED}=true', f'{EXPIRES}=never')
        elif name == 'base-prev' and config.get(MANAGED) == 'true' and not expires.isdigit():
            retire = int(time.time() + ROLLBACK_WINDOW)
            ic('config', 'set', name, f'{MANAGED}=true', f'{EXPIRES}={retire}')
            print(f'coldbox reap: base-prev kept for rollback until {retire}')
        elif not pending and name not in ('base-dev', 'base-rollback') and config.get(MANAGED) == 'true' \
                and expires.isdigit() and int(expires) < time.time():
            gone = destroy(name)
            failed += not gone
            print(f"coldbox reap: {name} expired; {'deleted' if gone else 'FAILED to delete'}")
    return failed


def fetch_json(url):
    headers = {'Accept': 'application/vnd.github+json', 'User-Agent': 'coldbox'}
    if urllib.parse.urlparse(url).netloc == 'api.github.com' and (token := app_token()):
        headers['Authorization'] = f'Bearer {token}'
    request = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response)


